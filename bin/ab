operation_readiness_result="not-applicable"
operation_task_status="fail"
operation_agent_execution="blocked"
operation_explicit_exec="blocked"
operation_retry_command="ab start --apply"
operation_record_cleanup="forbidden"
operation_failed_phase=""
operation_connect_network_status=ok
operation_record_active=0
operation_record_sequence=0

# Task 8's single read-only projection.  Keep the Task 7 producer fields above for lifecycle
# writes, but make consumers use this stable vocabulary instead of inferring permissions from a
# raw status string or reparsing the record themselves.
operation_state_record_path=""
operation_state_operation_id=""
operation_state_phase=""
operation_state_terminal_status="none"
operation_state_container_name=""
