#!/usr/bin/env bash
# shellcheck disable=SC2015,SC2034 # intentional short-circuit idioms and exported context fields
#
# ab — Claude Code / Codex in a long-lived, **Sysbox-confined** agentbox container.
#
# agentbox is launched with `docker run --runtime=sysbox-runc`: Sysbox isolates the
# container so the inner Docker daemon (rootful, in-container) cannot reach the host —
# nested Docker with no --privileged and no host docker socket.
#
#   ab start [--no-git] [--grant-gh] [--grant-all-of-dot-ssh] [--apply]
#                            create + start the container for the current project
#   ab stop                  stop it (kept on disk; /tmp build state preserved)
#   ab destroy               stop + remove it (destroyed; /tmp build state lost)
#   ab status                show whether the container is running
#   ab config                show which per-machine/per-project config files are in effect
#   ab config init [--machine] [--project] [file...]
#                            create a config tier's directory (+ starter templates for the
#                            named files, e.g. env mounts ports setup.sh networks Dockerfile)
#   ab logs                  tail the container / inner-dockerd logs
#   ab claude [args...]      docker exec claude as the agentbox user (auto-starts if not started)
#   ab codex  [args...]      docker exec codex
#   ab bash                  docker exec bash
#   ab exec <cmd...>         docker exec an arbitrary command (as agentbox)
#   ab build   [--no-git] [--no-cache] [--grant-gh] [--grant-all-of-dot-ssh]
#   ab rebuild [--no-git] [--no-cache] [--grant-gh] [--grant-all-of-dot-ssh]  (synonym for build)
#                            build or rebuild the image and recreate the running container (--no-cache
#                            busts Docker's build cache too — needed to actually pick up a newer
#                            claude/codex release, since CLAUDE_CHANNEL=stable/CODEX_RELEASE=latest
#                            otherwise just re-hit the cached install layer from the last build)
#   ab --version             print the agentbox version
#
# Each project path gets its own container (and its own inner-docker data root), so
# per-container state — notably CARGO_TARGET_DIR=/tmp/target — persists across ab
# invocations until `ab destroy`.
#
# Host prerequisite: Sysbox must be installed + registered as a docker runtime
# (see README.md). `ab start` checks for it and bails with guidance if missing.
#
set -euo pipefail

policy_fail() {
  echo "agentbox: policy: $*" >&2
  return 1
}

# Host credential mounts are per-invocation grants, deliberately disabled by default.
grant_gh=0
grant_all_of_dot_ssh=0
grant_labels=()
policy_labels=()
policy_git_enabled=""
policy_grant_gh=""
policy_grant_all_of_dot_ssh=""
policy_updates_check=""
policy_git_source="default"
policy_grant_gh_source="default"
policy_grant_all_of_dot_ssh_source="default"
policy_updates_source="default"
policy_recorded_status="none"
policy_recorded_git_enabled=""
policy_recorded_grant_gh=""
policy_recorded_grant_all_of_dot_ssh=""
policy_recorded_digest=""
policy_recorded_detail=""
policy_needs_recreate=0
policy_cli_git_enabled=""
policy_cli_grant_gh=""
policy_cli_grant_all_of_dot_ssh=""
policy_apply=0
policy_command_args=()
policy_input_env_captured=0
policy_operation_requested=0
policy_snapshot_retry_count=0

# Task 2's raw host-policy record. Keep capture separate from the resolved policy below so later
# policy work consumes one validated snapshot instead of reparsing CLI arguments or environment.
# Every field is always present and is exactly one of unset, true, or false.
declare -A policy_input=()
policy_input_reset() {
  policy_input_env_captured=0
  policy_input=(
    [cli_git_enabled]=unset
    [cli_grant_gh]=unset
    [cli_grant_ssh]=unset
    [env_git_enabled]=unset
    [env_grant_gh]=unset
    [env_grant_ssh]=unset
  )
}

policy_input_reset

policy_input_record() {
  local field
  for field in cli_git_enabled cli_grant_gh cli_grant_ssh \
               env_git_enabled env_grant_gh env_grant_ssh; do
    printf '%s=%s\n' "$field" "${policy_input[$field]}"
  done
}

# Parse one host boolean without consulting container env files. The caller supplies the
# environment variable name for stable diagnostics and the value so this function is pure.
policy_input_bool() {
  local name="$1" value="${2,,}"
  case "$value" in
    1|true|yes|on) POLICY_INPUT_BOOL=true ;;
    0|false|no|off) POLICY_INPUT_BOOL=false ;;
    *) policy_fail "$name must be a boolean (1/0, true/false, yes/no, or on/off)"; return 1 ;;
  esac
}

policy_input_capture_env() {
  local value
  [ "$policy_input_env_captured" = 0 ] || return 0
  policy_input[env_git_enabled]="unset"
  policy_input[env_grant_gh]="unset"
  policy_input[env_grant_ssh]="unset"

  if [[ -v AGENTBOX_NO_GIT ]]; then
    policy_input_bool AGENTBOX_NO_GIT "$AGENTBOX_NO_GIT" || return 1
    value="$POLICY_INPUT_BOOL"
    if [ "$value" = true ]; then value=false; else value=true; fi
    policy_input[env_git_enabled]="$value"
  fi
  if [[ -v AGENTBOX_GRANT_GH ]]; then
    policy_input_bool AGENTBOX_GRANT_GH "$AGENTBOX_GRANT_GH" || return 1
    policy_input[env_grant_gh]="$POLICY_INPUT_BOOL"
  fi
  if [[ -v AGENTBOX_GRANT_ALL_OF_DOT_SSH ]]; then
    policy_input_bool AGENTBOX_GRANT_ALL_OF_DOT_SSH "$AGENTBOX_GRANT_ALL_OF_DOT_SSH" || return 1
    policy_input[env_grant_ssh]="$POLICY_INPUT_BOOL"
  fi
  policy_input_env_captured=1
}

policy_input_begin() {
  policy_input_reset
  policy_input_capture_env
}

policy_input_apply_cli() {
  policy_cli_git_enabled=""
  policy_cli_grant_gh=""
  policy_cli_grant_all_of_dot_ssh=""
  case "${policy_input[cli_git_enabled]}" in
    true) policy_cli_git_enabled=1 ;;
    false) policy_cli_git_enabled=0 ;;
  esac
  case "${policy_input[cli_grant_gh]}" in
    true) policy_cli_grant_gh=1 ;;
    false) policy_cli_grant_gh=0 ;;
  esac
  case "${policy_input[cli_grant_ssh]}" in
    true) policy_cli_grant_all_of_dot_ssh=1 ;;
    false) policy_cli_grant_all_of_dot_ssh=0 ;;
  esac
}

policy_input_set_cli() {
  case "$1" in
    --no-git) policy_input[cli_git_enabled]=false; policy_cli_git_enabled=0 ;;
    --grant-gh) policy_input[cli_grant_gh]=true; policy_cli_grant_gh=1 ;;
    --grant-all-of-dot-ssh) policy_input[cli_grant_ssh]=true; policy_cli_grant_all_of_dot_ssh=1 ;;
    *) return 1 ;;
  esac
}

IMAGE_NAME="agentbox"
# Public but unreleased; bump PATCH only until there's a real release / second user.
AB_VERSION='0.0.11'
AB_GITHUB_REPO="nevdelap/agentbox"

# Resolve the agentbox repo root (the dir holding the Dockerfile) from this script's
# real location — works whether `ab` is run in place or reached via a symlink on PATH
# (e.g. ~/.bin/ab -> .../agentbox/bin/ab). Override with $AGENTBOX_CONTEXT if needed.
_self="$(readlink -f "${BASH_SOURCE[0]}")"
CONTEXT="${AGENTBOX_CONTEXT:-$(cd "$(dirname "$_self")/.." && pwd)}"
LAUNCHER_ROOT="$(cd "$(dirname "$_self")/.." && pwd)"
GIT_BLOCKER="$LAUNCHER_ROOT/runtime/git-disabled"

PROJECT_DIR="${AGENTBOX_DIR:-$PWD}"
PROJECT_DIR="$(cd -- "$PROJECT_DIR" && pwd -P)" || {
  echo "agentbox: project dir not found: ${AGENTBOX_DIR:-$PWD}" >&2
  exit 1
}

# Task 3 canonical identity helpers. These deliberately return the canonical value rather than
# mutating global state, so tests and later policy tasks can use the same functions at every seam.
canonical_machine_name() {
  local name="$1"
  [[ "$name" =~ ^[A-Za-z0-9]([A-Za-z0-9._-]{0,62}[A-Za-z0-9])?$ ]] || {
    policy_fail "machine name must be 1-64 ASCII letters, digits, '.', '_' or '-' and may not start/end with punctuation: $name"
    return 1
  }
  printf '%s' "$name"
}

canonical_project_path() {
  local path="$1" physical
  physical="$(cd -- "$path" 2>/dev/null && pwd -P)" || {
    policy_fail "project directory does not exist or is not accessible: $path"
    return 1
  }
  [ -d "$physical" ] || { policy_fail "project path is not a directory: $path"; return 1; }
  printf '%s' "$physical"
}

# Names unique to the FULL project path (not just the dir name): the same basename in
# two parents (~/a/foo, ~/b/foo) must get distinct containers + volumes. We fold the
# path into a readable slug (so `docker ps` shows which project) and append a long
# sha256 substring so even truncated/deep paths never collide.
# Extracted into a function so the unit tests (tests/run.sh) can source this file and
# exercise the derivation directly.
compute_names() {
  local dir="$1"
  slug="$(printf '%s' "$dir" | tr -cs '[:alnum:]' '-' | sed 's/^-\+//')"
  slug="${slug:0:80}"
  hash="$(printf '%s' "$dir" | sha256sum | cut -c1-16)"
  cname="agentbox-${slug}-${hash}"       # one container per project path
  dvol="agentbox-docker-${slug}-${hash}" # ...and its own inner-docker data root
  jvol="agentbox-jj-${slug}-${hash}"     # ...and its own jj secure repo/workspace state
}
compute_names "$PROJECT_DIR"
uid="$(id -u)"

# --- per-machine / per-project config resolution --------------------------------
# The four optional config files (env, files, ports, setup.sh) are each resolved separately, so
# one ~/.config/agentbox tree — checked in and shared across machines — can hold a global
# default plus per-machine, per-project, and per-machine-per-project overrides.
AB_CFG_ROOT="$HOME/.config/agentbox"
AB_CFG_CONTAINER=/home/agentbox/.config/agentbox
JJ_STATE_CONTAINER=/home/agentbox/.config/jj
# The machine name keying the search. Defaults to the host's name (the same value ab gives the
# container via --hostname); AGENTBOX_MACHINE overrides it, so a machine can be renamed — or a
# rename rehearsed — without moving directories. It deliberately does NOT change --hostname.
MACHINE="$(canonical_machine_name "${AGENTBOX_MACHINE:-$(hostname)}")" || exit 1

# The four candidate paths for one config file <name>, most specific first: this project on this
# machine, this machine (any project), this project (any machine), then the plain top-level file
# — which is exactly the pre-per-project behaviour, so an existing flat config keeps working
# untouched. `machines/` and `projects/` are reserved directory names at the config root: without
# them a machine called `home` would be indistinguishable from the first segment of a project
# path like /home/alice/myproj, and the search would silently resolve the ambiguity the wrong way.
# The project component is its absolute path with the leading slash dropped
# (/home/alice/myproj -> home/alice/myproj). Pure (no filesystem access) and parameterised on the
# root, so tests/run.sh can exercise the ordering directly.
ab_config_candidates() {
  local root="$1" machine="$2" proj="${3#/}" name="$4"
  printf '%s\n' \
    "$root/machines/$machine/projects/$proj/$name" \
    "$root/machines/$machine/$name" \
    "$root/projects/$proj/$name" \
    "$root/$name"
}

# First existing candidate for <name> (same args as ab_config_candidates), or nothing when none
# of the four exist. Only regular files count — a directory sitting at a candidate path is
# skipped, not treated as a match. Always returns 0: callers run it in a command substitution
# under `set -e`, and "no config file" is a normal, silent outcome (all four are optional).
ab_config_file() {
  local c
  while IFS= read -r c; do
    if [ -f "$c" ]; then
      printf '%s' "$c"
      return 0
    fi
  done < <(ab_config_candidates "$@")
  return 0
}

# Policy files are deliberately separate from the first-match config files above: each policy
# field inherits independently through all four tiers. The order here is least-specific first so
# later assignments are the more-specific overrides.
ab_policy_candidates() {
  local root="$1" machine="$2" proj="${3#/}"
  printf '%s\n' \
    "$root/agentbox.toml" \
    "$root/machines/$machine/agentbox.toml" \
    "$root/projects/$proj/agentbox.toml" \
    "$root/machines/$machine/projects/$proj/agentbox.toml"
}

# Reject a symlink anywhere below the policy root. `test -f` follows symlinked parent
# directories, which would otherwise let a policy source move outside the configured tree.
policy_path_has_symlink() {
  local path="$1" root="$2" rest part current
  case "$path" in
    "$root") rest="" ;;
    "$root"/*) rest="${path#"$root"/}" ;;
    *) return 1 ;;
  esac
  [ ! -L "$root" ] || return 0
  current="$root"
  while [ -n "$rest" ]; do
    part="${rest%%/*}"
    if [ "$rest" = "$part" ]; then rest=""; else rest="${rest#*/}"; fi
    current="$current/$part"
    [ ! -L "$current" ] || return 0
  done
  return 1
}
policy_file_safe() {
  local file="$1" mode last
  [ -f "$file" ] && [ ! -L "$file" ] && [ -r "$file" ] || return 1
  mode="$(stat -c '%a' "$file" 2>/dev/null || true)"
  [ -n "$mode" ] || return 1
  last="${mode: -1}"
  case "$last" in 2|3|6|7) return 1 ;; esac # world-writable
  return 0
}


# Immutable policy-source snapshot. Absent paths are recorded as well, so a file created during
# resolution is detected before Docker mutation.
declare -A policy_snapshot_state=() policy_snapshot_size=() policy_snapshot_identity=()
declare -A policy_snapshot_hash=() policy_snapshot_content=()
policy_snapshot_paths=()
policy_snapshot_ready=0
policy_snapshot_changed_path=""

policy_source_identity() {
  stat -c '%F|%d|%i|%a|%s|%Y' -- "$1" 2>/dev/null
}

policy_snapshot_reset() {
  policy_snapshot_state=()
  policy_snapshot_size=()
  policy_snapshot_identity=()
  policy_snapshot_hash=()
  policy_snapshot_content=()
  policy_snapshot_paths=()
  policy_snapshot_ready=0
  policy_snapshot_changed_path=""
}

policy_snapshot_take() {
  local file content size identity hash
  policy_snapshot_reset
  while IFS= read -r file; do
    policy_snapshot_paths+=("$file")
    policy_snapshot_state["$file"]=absent
    if policy_path_has_symlink "$file" "$AB_CFG_ROOT"; then
      policy_snapshot_state["$file"]=invalid
      policy_fail "$file uses a symlinked policy tier or file"
      return 1
    fi
    if [ -L "$file" ] || [ -e "$file" ]; then
      policy_file_safe "$file" || {
        policy_snapshot_state["$file"]=invalid
        policy_fail "$file must be a readable, non-world-writable regular file"
        return 1
      }
      content="$(<"$file")"
      size="$(wc -c <"$file")"; size="${size//[[:space:]]/}"
      identity="$(policy_source_identity "$file")" || return 1
      hash="$(sha256sum -- "$file" | cut -d' ' -f1)"
      policy_snapshot_state["$file"]=regular
      policy_snapshot_size["$file"]="$size"
      policy_snapshot_identity["$file"]="$identity"
      policy_snapshot_hash["$file"]="$hash"
      policy_snapshot_content["$file"]="$content"
    fi
  done < <(ab_policy_candidates "$AB_CFG_ROOT" "$MACHINE" "$PROJECT_DIR")
  policy_snapshot_ready=1
}

policy_snapshot_recheck() {
  local file state content size identity hash
  [ "$policy_snapshot_ready" = 1 ] || return 0
  policy_snapshot_changed_path=""
  for file in "${policy_snapshot_paths[@]}"; do
    state="${policy_snapshot_state[$file]}"
    if policy_path_has_symlink "$file" "$AB_CFG_ROOT" || [ -L "$file" ]; then
      policy_snapshot_changed_path="$file"; return 1
    fi
    if [ ! -e "$file" ]; then
      if [ "$state" != absent ]; then policy_snapshot_changed_path="$file"; return 1; fi
      continue
    fi
    if [ "$state" != regular ]; then policy_snapshot_changed_path="$file"; return 1; fi
    if ! policy_file_safe "$file"; then policy_snapshot_changed_path="$file"; return 1; fi
    content="$(<"$file")"
    size="$(wc -c <"$file")"; size="${size//[[:space:]]/}"
    identity="$(policy_source_identity "$file")" || { policy_snapshot_changed_path="$file"; return 1; }
    hash="$(sha256sum -- "$file" | cut -d' ' -f1)"
    if [ "$size" != "${policy_snapshot_size[$file]}" ] ||
       [ "$identity" != "${policy_snapshot_identity[$file]}" ] ||
       [ "$hash" != "${policy_snapshot_hash[$file]}" ]; then
      policy_snapshot_changed_path="$file"; return 1
    fi
  done
}

# The resolved mounts file is a second policy source: unlike agentbox.toml it is first-match
# configuration, but its destinations still decide which host paths enter the container. Keep a
# content/identity snapshot alongside the TOML snapshot so a replacement or edit cannot slip
# between preflight and the final docker run.
custom_mounts_snapshot_path=""
custom_mounts_snapshot_identity=""
custom_mounts_snapshot_hash=""
custom_mounts_snapshot_ready=0

custom_mounts_snapshot_reset() {
  custom_mounts_snapshot_path=""
  custom_mounts_snapshot_identity=""
  custom_mounts_snapshot_hash=""
  custom_mounts_snapshot_ready=0
}

custom_mounts_snapshot_take() {
  custom_mounts_snapshot_reset
  custom_mounts_snapshot_path="$cfg_mounts"
  custom_mounts_snapshot_ready=1
  [ -n "$cfg_mounts" ] || return 0
  [ -f "$cfg_mounts" ] && [ ! -L "$cfg_mounts" ] && [ -r "$cfg_mounts" ] || {
    policy_snapshot_changed_path="$cfg_mounts"
    policy_fail "mounts source must be a readable, non-symlink regular file: $cfg_mounts"
    return 1
  }
  custom_mounts_snapshot_identity="$(policy_source_identity "$cfg_mounts")" || return 1
  custom_mounts_snapshot_hash="$(sha256sum -- "$cfg_mounts" | cut -d' ' -f1)"
}

custom_mounts_snapshot_recheck() {
  local identity hash
  [ "$custom_mounts_snapshot_ready" = 1 ] || return 0
  [ "$cfg_mounts" = "$custom_mounts_snapshot_path" ] || {
    policy_snapshot_changed_path="${custom_mounts_snapshot_path:-mounts}"
    return 1
  }
  [ -n "$custom_mounts_snapshot_path" ] || return 0
  [ -f "$custom_mounts_snapshot_path" ] && [ ! -L "$custom_mounts_snapshot_path" ] && [ -r "$custom_mounts_snapshot_path" ] || {
    policy_snapshot_changed_path="$custom_mounts_snapshot_path"
    return 1
  }
  identity="$(policy_source_identity "$custom_mounts_snapshot_path")" || {
    policy_snapshot_changed_path="$custom_mounts_snapshot_path"
    return 1
  }
  hash="$(sha256sum -- "$custom_mounts_snapshot_path" | cut -d' ' -f1)"
  if [ "$identity" != "$custom_mounts_snapshot_identity" ] ||
     [ "$hash" != "$custom_mounts_snapshot_hash" ]; then
    policy_snapshot_changed_path="$custom_mounts_snapshot_path"
    return 1
  fi
}

# One advisory lock per canonical project/machine identity. The descriptor remains open in this
# launcher process (and is inherited by docker exec), so the lock spans inspection, mutation, and
# the final command report. A lock cannot be silently bypassed when the preferred directory is
# unavailable: the documented cache fallbacks are tried in order instead.
lock_timeout_seconds=30
lock_identity=""
lock_path=""
lock_result=""
agentbox_lock_fd=""

policy_lock_identity() {
  printf '%s\0%s' "$PROJECT_DIR" "$MACHINE" | sha256sum | cut -d' ' -f1
}

policy_lock_acquire() {
  [ -n "$agentbox_lock_fd" ] && return 0
  local identity base dir path fd deadline acquired=0
  identity="$(policy_lock_identity)"
  lock_identity="$identity"
  lock_result=failed
  local -a bases=()
  [ -n "${XDG_RUNTIME_DIR:-}" ] && bases+=("$XDG_RUNTIME_DIR")
  [ -n "${XDG_CACHE_HOME:-}" ] && bases+=("$XDG_CACHE_HOME")
  bases+=("$HOME/.cache")
  for base in "${bases[@]}"; do
    dir="$base/agentbox/locks"
    if ! mkdir -p -- "$dir" 2>/dev/null || ! chmod 700 -- "$dir" 2>/dev/null; then
      continue
    fi
    path="$dir/$identity.lock"
    if ! ( : >>"$path" ) 2>/dev/null || ! chmod 600 -- "$path" 2>/dev/null; then
      continue
    fi
    lock_path="$path"
    if ! command -v flock >/dev/null 2>&1; then
      lock_result=failed
      policy_fail "lock failed for $PROJECT_DIR: flock is unavailable"
      return 1
    fi
    exec {fd}>"$path" || continue
    # The file is created/truncated above only to establish its required mode; flock owns the
    # actual advisory exclusion and the descriptor is intentionally not closed until exit.
    deadline=$((SECONDS + lock_timeout_seconds))
    while ! flock -n "$fd"; do
      if [ "$SECONDS" -ge "$deadline" ]; then
        exec {fd}>&-
        lock_result=busy
        policy_fail "project busy: $PROJECT_DIR ($cname); retry after the current operation finishes"
        return 1
      fi
      sleep 0.1
    done
    agentbox_lock_fd="$fd"
    lock_result=acquired
    acquired=1
    break
  done
  [ "$acquired" = 1 ] || {
    lock_result=failed
    policy_fail "lock failed for $PROJECT_DIR: unable to create or open a lock path"
    return 1
  }
}

# Parse the intentionally small, strict TOML policy schema. This accepts TOML table headers,
# boolean assignments, whitespace, and trailing comments; all other syntax is rejected before
# Docker or the update check is reached.
policy_parse_file() {
  local file="$1" line t table key value input
  local -A seen=()
  policy_parsed_git_enabled=""
  policy_parsed_grant_gh=""
  policy_parsed_grant_all_of_dot_ssh=""
  policy_parsed_updates_check=""
  if [ "${policy_snapshot_state[$file]:-}" = regular ]; then
    input="${policy_snapshot_content[$file]}"
  else
    input="$(<"$file")"
  fi
  while IFS= read -r line || [ -n "$line" ]; do
    t="${line#"${line%%[![:space:]]*}"}"
    t="${t%"${t##*[![:space:]]}"}"
    [ -n "$t" ] || continue
    case "$t" in \#*) continue ;; esac
    if [[ "$t" =~ ^\[([a-z]+)\]$ ]]; then
      table="${BASH_REMATCH[1]}"
      case "$table" in git|github|ssh|updates) ;; *) policy_fail "$file: unknown table [$table]"; return 1 ;; esac
      continue
    fi
    [[ "$t" == *=* ]] || { policy_fail "$file: expected [table] or key = true|false: $t"; return 1; }
    key="${t%%=*}"; value="${t#*=}"
    key="${key%"${key##*[![:space:]]}"}"
    key="${key#"${key%%[![:space:]]*}"}"
    value="${value%%#*}"
    value="${value#"${value%%[![:space:]]*}"}"
    value="${value%"${value##*[![:space:]]}"}"
    [ -n "${table:-}" ] || { policy_fail "$file: key outside a recognized table: $key"; return 1; }
    case "$table.$key" in
      git.enabled) var=policy_parsed_git_enabled ;;
      github.grant) var=policy_parsed_grant_gh ;;
      ssh.grant_all) var=policy_parsed_grant_all_of_dot_ssh ;;
      updates.check) var=policy_parsed_updates_check ;;
      *) policy_fail "$file: unknown key $table.$key"; return 1 ;;
    esac
    [ -z "${seen[$table.$key]+x}" ] || { policy_fail "$file: duplicate key $table.$key"; return 1; }
    case "$value" in true|false) ;; *) policy_fail "$file: $table.$key must be true or false"; return 1 ;; esac
    seen[$table.$key]=1
    printf -v "$var" '%s' "$value"
  done <<< "$input"
}

policy_load_files() {
  policy_file_git_enabled=""
  policy_file_grant_gh=""
  policy_file_grant_all_of_dot_ssh=""
  policy_file_updates_check=""
  policy_git_source="default"
  policy_grant_gh_source="default"
  policy_grant_all_of_dot_ssh_source="default"
  policy_updates_source="default"
  local file
  policy_snapshot_take || return 1
  for file in "${policy_snapshot_paths[@]}"; do
    [ "${policy_snapshot_state[$file]}" = regular ] || continue
    policy_parse_file "$file" || return 1
    if [ -n "$policy_parsed_git_enabled" ]; then policy_file_git_enabled="$policy_parsed_git_enabled"; policy_git_source="$file"; fi
    if [ -n "$policy_parsed_grant_gh" ]; then policy_file_grant_gh="$policy_parsed_grant_gh"; policy_grant_gh_source="$file"; fi
    if [ -n "$policy_parsed_grant_all_of_dot_ssh" ]; then policy_file_grant_all_of_dot_ssh="$policy_parsed_grant_all_of_dot_ssh"; policy_grant_all_of_dot_ssh_source="$file"; fi
    if [ -n "$policy_parsed_updates_check" ]; then policy_file_updates_check="$policy_parsed_updates_check"; policy_updates_source="$file"; fi
  done
}

policy_parse_env_bool() {
  local name="$1" value
  if [[ ! -v "$name" ]]; then return 2; fi
  value="${!name,,}"
  case "$value" in
    1|true|yes|on) POLICY_BOOL=1 ;;
    0|false|no|off) POLICY_BOOL=0 ;;
    *) policy_fail "$name must be a boolean (1/0, true/false, yes/no, or on/off)"; return 1 ;;
  esac
  return 0
}

policy_bool01() { [ "$1" = true ] && printf '1' || printf '0'; }
policy_bool_text() { [ "$1" = 1 ] && printf 'true' || printf 'false'; }

policy_load_host() {
  MACHINE="$(canonical_machine_name "$MACHINE")" || return 1
  policy_input_capture_env || return 1
  policy_input_apply_cli
  policy_load_files || return 1
  policy_git_enabled="$(policy_bool01 "${policy_file_git_enabled:-true}")"
  policy_grant_gh="$(policy_bool01 "${policy_file_grant_gh:-false}")"
  policy_grant_all_of_dot_ssh="$(policy_bool01 "${policy_file_grant_all_of_dot_ssh:-false}")"
  policy_updates_check="$(policy_bool01 "${policy_file_updates_check:-true}")"
  case "${policy_input[env_git_enabled]}" in
    true) policy_git_enabled=1; policy_git_source=environment ;;
    false) policy_git_enabled=0; policy_git_source=environment ;;
  esac
  case "${policy_input[env_grant_gh]}" in
    true) policy_grant_gh=1; policy_grant_gh_source=environment ;;
    false) policy_grant_gh=0; policy_grant_gh_source=environment ;;
  esac
  case "${policy_input[env_grant_ssh]}" in
    true) policy_grant_all_of_dot_ssh=1; policy_grant_all_of_dot_ssh_source=environment ;;
    false) policy_grant_all_of_dot_ssh=0; policy_grant_all_of_dot_ssh_source=environment ;;
  esac
  if [[ -v AGENTBOX_NO_UPDATE_CHECK ]]; then policy_parse_env_bool AGENTBOX_NO_UPDATE_CHECK || return 1; policy_updates_check=$((1-POLICY_BOOL)); policy_updates_source=environment; fi
  [ -n "$policy_cli_git_enabled" ] && policy_git_enabled="$policy_cli_git_enabled" && policy_git_source=cli
  [ -n "$policy_cli_grant_gh" ] && policy_grant_gh="$policy_cli_grant_gh" && policy_grant_gh_source=cli
  [ -n "$policy_cli_grant_all_of_dot_ssh" ] && policy_grant_all_of_dot_ssh="$policy_cli_grant_all_of_dot_ssh" && policy_grant_all_of_dot_ssh_source=cli
  return 0
}

policy_payload() {
  printf 'schema_version=1\ngit_enabled=%s\ngithub_grant=%s\nssh_grant_all=%s\n' \
    "$(policy_bool_text "$1")" "$(policy_bool_text "$2")" "$(policy_bool_text "$3")"
}

policy_digest_for() {
  policy_payload "$1" "$2" "$3" | sha256sum | cut -d' ' -f1
}

# Container-side path of a resolved config file. The whole config root is bind-mounted ro at
# $AB_CFG_CONTAINER, so any resolved path maps by swapping that prefix. Empty in -> empty out
# (nothing resolved, nothing to pass).
ab_config_container_path() {
  local p="$1"
  [ -n "$p" ] || return 0
  printf '%s' "$AB_CFG_CONTAINER${p#"$AB_CFG_ROOT"}"
}

# How `ab config` renders one resolved path: "(none)" when nothing matched, else the path with
# $HOME abbreviated to ~ (these are long, and the tier that won is the part worth reading).
ab_config_show() {
  if [ -z "$1" ]; then printf '(none)'; else printf '%s' "${1/#"$HOME"/\~}"; fi
}

# Like ab_config_show, but for the dockerfile slot specifically: an empty (comments/blanks-only)
# Dockerfile is the README's sanctioned way to opt a tier out of a less-specific one, but a bare
# path gives no hint of that — flag it so `ab config` doesn't imply a child image will build when
# it won't.
ab_config_show_dockerfile() {
  [ -n "$1" ] || { printf '(none)'; return 0; }
  local note=""
  ab_dockerfile_has_content "$1" || note=' (empty — base image runs)'
  printf '%s%s' "${1/#"$HOME"/\~}" "$note"
}

# Resolve all four once, up front: `ab config` prints them, and cmd_start/build_user_mounts/
# run_args below consume them. Empty string = "no such config file on this host for this project".
# cfg_files_legacy is NOT a config file — `files` was replaced by `mounts`, and this only exists
# so a leftover `files` is reported instead of silently ignored (see warn_legacy_files).
cfg_env=""
cfg_mounts=""
cfg_ports=""
cfg_setup=""
cfg_networks=""
cfg_dockerfile=""
cfg_files_legacy=""
if [ -d "$AB_CFG_ROOT" ]; then
  cfg_env="$(ab_config_file "$AB_CFG_ROOT" "$MACHINE" "$PROJECT_DIR" env)"
  cfg_mounts="$(ab_config_file "$AB_CFG_ROOT" "$MACHINE" "$PROJECT_DIR" mounts)"
  cfg_ports="$(ab_config_file "$AB_CFG_ROOT" "$MACHINE" "$PROJECT_DIR" ports)"
  cfg_setup="$(ab_config_file "$AB_CFG_ROOT" "$MACHINE" "$PROJECT_DIR" setup.sh)"
  cfg_networks="$(ab_config_file "$AB_CFG_ROOT" "$MACHINE" "$PROJECT_DIR" networks)"
  cfg_dockerfile="$(ab_config_file "$AB_CFG_ROOT" "$MACHINE" "$PROJECT_DIR" Dockerfile)"
  cfg_files_legacy="$(ab_config_file "$AB_CFG_ROOT" "$MACHINE" "$PROJECT_DIR" files)"
fi

mounts=(
  -v "$PROJECT_DIR:/workspace"
  -v "$HOME/.claude:/home/agentbox/.claude"
  -v "$HOME/.codex:/home/agentbox/.codex"
  -v "$dvol:/var/lib/docker"
  -v "$jvol:/home/agentbox/.config/jj"
)
# Keep the agentbox README available in the agent's home directory. It is mounted
# read-only from the launcher checkout so agents can discover the confinement model
# and operating conventions without depending on the project being worked on.
if [ -f "$CONTEXT/README.md" ]; then
  mounts+=(-v "$CONTEXT/README.md:/home/agentbox/README.md:ro")
fi
# Optional host files/dirs mirrored in only when present (existence-guarded).
# ~/.claude.json carries the oauthAccount/userID Claude Code checks at startup to
# consider itself logged in — without it the container has an empty stub and prompts
# for login, even though ~/.claude/.credentials.json (the token) is mounted above.
add_host_config_mounts() {
  jj_config_paths=()
  [ -f "$HOME/.claude.json" ] && mounts+=(-v "$HOME/.claude.json:/home/agentbox/.claude.json")
  # jj loads the legacy user file and the platform config files from JJ_CONFIG. Keep these
  # read-only host mounts separate from /home/agentbox/.config/jj, where jj creates secure
  # repo/workspace config whose paths are specific to this container's /workspace mapping.
  if [ -f "$HOME/.jjconfig.toml" ]; then
    mounts+=(-v "$HOME/.jjconfig.toml:/home/agentbox/.jjconfig.toml:ro")
    jj_config_paths+=(/home/agentbox/.jjconfig.toml)
  fi
  local jj_config_dir="${XDG_CONFIG_HOME:-$HOME/.config}/jj"
  if [ -d "$jj_config_dir" ]; then
    if [ -f "$jj_config_dir/config.toml" ]; then
      mounts+=(-v "$jj_config_dir/config.toml:/home/agentbox/.config/jj-host-config.toml:ro")
      jj_config_paths+=(/home/agentbox/.config/jj-host-config.toml)
    fi
    if [ -d "$jj_config_dir/conf.d" ]; then
      mounts+=(-v "$jj_config_dir/conf.d:/home/agentbox/.config/jj-host-conf.d:ro")
      jj_config_paths+=(/home/agentbox/.config/jj-host-conf.d)
    fi
  fi
  [ -e /etc/localtime ] && mounts+=(-v "/etc/localtime:/etc/localtime:ro")
  # NixOS only: expose the nix store read-only so /nix/store shebangs & paths in the
  # workspace resolve inside the container.
  if [ -d /nix/store ]; then
    mounts+=(-v "/nix/store:/nix/store:ro")
  fi
}
add_host_config_mounts

# Git configuration is deliberately added only after host policy has been resolved. No-Git mode
# omits both ~/.gitconfig and the XDG fallback, while Git-enabled mode retains the old fallback
# behavior. The blocker is a read-only bind mount, so changing this policy requires container
# recreation but never an image rebuild.
add_policy_mounts() {
  mount_spec_build
  case "${mount_spec_state[git_config]}" in
    ro)
      mounts+=(-v "${mount_spec_source[git_config]}:${mount_spec_destination[git_config]}:ro")
      ;;
  esac
  case "${mount_spec_state[git_blocker]}" in
    ro)
      mounts+=(--mount "type=bind,src=${mount_spec_source[git_blocker]},dst=${mount_spec_destination[git_blocker]},readonly")
      ;;
  esac
}

# JJ_CONFIG overrides jj's default user-config search paths. That lets the host's user config
# remain read-only while the default /home/agentbox/.config/jj path is backed by the writable,
# per-project jvol above for jj's secure repo/workspace state. An empty array leaves jj's normal
# container-local defaults intact.
jj_config_env_arg() {
  [ "${#jj_config_paths[@]}" -gt 0 ] || return 0
  local joined
  joined="$(IFS=:; printf '%s' "${jj_config_paths[*]}")"
  printf 'JJ_CONFIG=%s' "$joined"
}

# Sysbox provides the confinement — the outer container needs NO capabilities, no
# seccomp relaxation, no devices. The run flags are the `sysbox-runc` runtime (registered
# on the host) and `--init`. `--init` inserts docker's bundled init (tini) as PID 1 so the
# entrypoint's backgrounded children — the per-port socat forwarders and the setup.sh
# subshell — get reaped instead of accumulating as zombies under the `tail -f /dev/null`
# that otherwise holds the foreground. The inner dockerd runs rootful-in-container, isolated
# by Sysbox; tooling runs as the unprivileged agentbox user via `docker exec --user`.
run_args=(
  --runtime=sysbox-runc
  --init                     # tini as PID 1 reaps the entrypoint's backgrounded children
  --hostname "$(hostname)"   # in-container hostname matches the real host
  -w /workspace
)

# Optional per-host customization dir (~/.config/agentbox). Absent → no-op (other machines are
# unaffected). Present → mount it ro, let the container reach declared host services over the
# docker host gateway, and pass an env file. `--add-host=…:host-gateway` is only a /etc/hosts
# entry — it grants the container NO capability, so the Sysbox confinement is intact (we do
# NOT use --network host). The WHOLE tree is mounted (not just the resolved files), so the
# entrypoint can read whichever `ports` / `setup.sh` won the search; ab tells it which via the
# two AGENTBOX_*_FILE env vars, as container-side paths under the mount. Those are set at
# container CREATE time, so adding a *more specific* ports/setup.sh later needs
# `ab destroy && ab start` — editing the contents of the one already in effect does not (it is
# read live from the mount). See README "Per-host and per-project customization".
if [ -d "$AB_CFG_ROOT" ]; then
  mounts+=(-v "$AB_CFG_ROOT:$AB_CFG_CONTAINER:ro")
  run_args+=(--add-host=host.docker.internal:host-gateway)
  [ -n "$cfg_env" ] && run_args+=(--env-file "$cfg_env")
  [ -n "$cfg_ports" ] && run_args+=(-e "AGENTBOX_PORTS_FILE=$(ab_config_container_path "$cfg_ports")")
  [ -n "$cfg_setup" ] && run_args+=(-e "AGENTBOX_SETUP_FILE=$(ab_config_container_path "$cfg_setup")")
fi
# Keep this after the optional env-file so a host config cannot override the safe separation of
# read-only host jj settings from writable container-local secure repo/workspace state.
jj_config_arg="$(jj_config_env_arg)"
[ -n "$jj_config_arg" ] && run_args+=(--env "$jj_config_arg")

# Fail fast with guidance if the host hasn't got Sysbox registered.
require_sysbox() {
  if ! docker info 2>/dev/null | grep -q 'sysbox-runc'; then
    cat >&2 <<EOF
agentbox: host Docker has no 'sysbox-runc' runtime registered.
agentbox needs Sysbox installed on the host (a prerequisite, like Docker itself):
  - Ubuntu:  sudo bash "$CONTEXT/install-sysbox-ubuntu.sh"
  - NixOS:   copy "$CONTEXT/sysbox.nix" to /etc/nixos, import it, then
             sudo nixos-rebuild switch
See "$CONTEXT/README.md" (Host prerequisite).
Then retry.
EOF
    exit 1
  fi
}

# Best-effort "you're behind" notice against GitHub's latest tagged release. Throttled to
# once an hour via a cache file's mtime, so `ab` doesn't hit the network on every
# invocation — a stale cache is read straight from disk, no curl involved. Silent on any
# failure (no curl, offline, GitHub unreachable/rate-limited, no releases yet): this is a
# courtesy, never a reason to slow down or break `ab`.
AB_UPDATE_CACHE="${XDG_CACHE_HOME:-$HOME/.cache}/agentbox/update-check"
check_for_update() {
  command -v curl >/dev/null 2>&1 || return 0
  local latest
  if [ -f "$AB_UPDATE_CACHE" ] && [ -z "$(find "$AB_UPDATE_CACHE" -mmin +60 2>/dev/null)" ]; then
    # Cache file's mtime is under an hour old — reuse it, no network call this run.
    latest="$(cat "$AB_UPDATE_CACHE" 2>/dev/null)"
  else
    # Missing or stale (over an hour old, or this is the first run) — refetch and restamp.
    # An empty result (curl failed, offline, no releases yet) is cached too, so a persistent
    # failure still only retries once an hour rather than on every invocation.
    latest="$(curl -fsS --max-time 2 "https://api.github.com/repos/$AB_GITHUB_REPO/releases/latest" 2>/dev/null \
      | sed -n 's/^[[:space:]]*"tag_name":[[:space:]]*"\(.*\)",\{0,1\}$/\1/p')"
    mkdir -p "$(dirname "$AB_UPDATE_CACHE")" && printf '%s' "$latest" >"$AB_UPDATE_CACHE"
  fi
  [ -n "$latest" ] || return 0
  local latest_num="${latest#v}"
  if [ "$latest_num" != "$AB_VERSION" ] &&
     [ "$(printf '%s\n%s\n' "$AB_VERSION" "$latest_num" | sort -V | tail -1)" = "$latest_num" ]; then
    echo "agentbox: a newer release is available: $latest (you have $AB_VERSION) — https://github.com/$AB_GITHUB_REPO/releases" >&2
  fi
}

# A resolved Dockerfile with no instruction lines (only comments/blanks) is "empty": treat it as
# absent, so an empty Dockerfile at a specific tier means "no child image here" (use the base) —
# the same way an empty env/mounts/ports/setup/networks file is a no-op (absent == empty). The
# empty tier still SHADOWS lower tiers (first existing file wins); this only makes its effect a
# no-op, so it's how a machine/project opts out of a less-specific Dockerfile. Pure (reads the
# file), so tests/run.sh can exercise it directly. '#' starts a comment only at a line's start
# (Dockerfile rule), so an inline '#' in an instruction is preserved and still counts as content.
ab_dockerfile_has_content() {
  [ -f "$1" ] || return 1          # absent file -> no content (absent == empty)
  local line t
  while IFS= read -r line || [ -n "$line" ]; do
    t="${line#"${line%%[![:space:]]*}"}"   # trim leading whitespace
    t="${t%"${t##*[![:space:]]}"}"          # trim trailing whitespace
    [ -n "$t" ] || continue                 # blank line
    case "$t" in '#'*) continue ;; esac     # comment line
    return 0                                # an instruction line -> has content
  done < "$1"
  return 1                                  # only comments/blanks -> empty
}

# Untag stale <uid> image tags, keeping only $keep. Matches tags containing $match; when $exclude
# is non-empty, tags containing it are left alone (so the base-tag prune doesn't sweep up child
# tags, which share the "${IMAGE_NAME}:${uid}-" prefix). Best-effort, same as the pipelines this
# replaces: a tag still pinned by a running container fails removal silently (the trailing
# `|| true`) and is retried on the next prune once nothing pins it. Kept as one pipeline (not
# intermediate command substitutions) so a no-match `grep` — a normal outcome, not an error —
# doesn't trip `set -e` via pipefail; `|| true` covers the whole pipeline's exit status.
prune_images() {
  local match="$1" exclude="${2:-}" keep="$3"
  if [ -n "$exclude" ]; then
    docker image ls --format '{{.Repository}}:{{.Tag}}' \
      | grep -F "$match" | grep -vF "$exclude" | grep -vxF "$keep" \
      | xargs -r docker image rm >/dev/null 2>&1 || true
  else
    docker image ls --format '{{.Repository}}:{{.Tag}}' \
      | grep -F "$match" | grep -vxF "$keep" \
      | xargs -r docker image rm >/dev/null 2>&1 || true
  fi
}

build_image() {
  local force="${1:-}" nocache="${2:-}" mode="${3:-rebuild}" files=() f digest tag log child build_flags
  [ -f "$CONTEXT/Dockerfile" ] || {
    echo "agentbox: Dockerfile not found at $CONTEXT/Dockerfile" >&2
    exit 1
  }
  for f in Dockerfile agentbox-entrypoint.sh .bashrc .dockerignore; do
    [ -f "$CONTEXT/$f" ] && files+=("$CONTEXT/$f")
  done
  # Fold the build args `ab` actually varies into the freshness digest, not just the file
  # contents — so a change to HOST_UID/HOST_GID/AB_VERSION invalidates the cached image instead of
  # silently reusing a tag built for different args. (CLAUDE_CHANNEL/CODEX_RELEASE aren't
  # passed here today — the Dockerfile defaults apply — so pinning them still requires a
  # direct `docker build`; that path never consults this digest.)
  digest="$( { cat "${files[@]}"; printf 'HOST_UID=%s\nHOST_GID=%s\nAGENTBOX_VERSION=%s\n' "$uid" "$(id -g)" "$AB_VERSION"; } | sha256sum | cut -c1-12)"
  tag="$IMAGE_NAME:${uid}-${digest}"
  if [ "$force" = "force" ] || ! docker image inspect "$tag" >/dev/null 2>&1; then
    echo "agentbox: building $tag ..." >&2
    # Capture the full build log and print it ONLY on failure (silent on success).
    # --progress=plain keeps the captured output linear/readable (no progress-bar
    # redraws) for when it is shown. Capturing into $log (not raw stdout) also keeps the
    # image ID out of the tag this function returns — the cause of the earlier
    # --quiet "invalid reference format" bug.
    build_flags=(--progress=plain)
    # This digest only tracks OUR OWN file contents + build args — it has no way to know that
    # `curl .. | bash -s stable` (or --release latest) resolves to a NEWER claude/codex release
    # than last time. Without --no-cache, Docker's own layer cache reuses that RUN step verbatim
    # forever (same instruction text = cache hit), so CLAUDE_CHANNEL=stable/CODEX_RELEASE=latest
    # silently freeze at whatever they resolved to on the very first build on this machine.
    [ "$nocache" = --no-cache ] && build_flags+=(--no-cache)
    policy_final_mutation_guard "$mode" || return 1
    if ! log="$(docker build "${build_flags[@]}" \
        --build-arg "HOST_UID=$uid" --build-arg "HOST_GID=$(id -g)" \
        --build-arg "AGENTBOX_VERSION=$AB_VERSION" \
        -t "$tag" -t "$IMAGE_NAME:latest" "$CONTEXT" 2>&1)"; then
      printf '%s\n' "$log" >&2
      echo "agentbox: image build failed (see above)" >&2
      return 1
    fi
    # Prune stale per-uid tags from prior builds (keep only this one + :latest). Best-effort:
    # a running container still references an old image's layers, so rmi just untags it then;
    # errors (image in use) are ignored. Stops agentbox:<uid>-<oldhash> images piling up.
    prune_images "${IMAGE_NAME}:${uid}-" "${IMAGE_NAME}:${uid}-custom-" "$tag"
  fi
  if [ -n "$cfg_dockerfile" ] && ab_dockerfile_has_content "$cfg_dockerfile"; then
    child="$(build_user_image "$tag" "$force" "$nocache" "$mode")" || return 1
    printf '%s' "$child"
  else
    printf '%s' "$tag"
  fi
}

# Build the user's child image (FROM agentbox:latest) when a user-side Dockerfile is resolved —
# the place for tools that need root at build (apt-get install …), keeping the repo base lean.
# The child is self-contained: no cross-tier chaining, so a winning machine/project Dockerfile
# must restate anything it wants from a lower tier (e.g. micro). Edit it, then `ab rebuild`.
#
# Mirrors build_image's shape: no --pull (FROM agentbox:latest resolves from the LOCAL store
# build_image just refreshed — never a registry); silent on success, full log on failure; and a
# per-project child prune keeping only the current child tag. The digest folds base_tag + the
# Dockerfile text, so a base rebuild OR a Dockerfile edit invalidates the cached child. NOTE: a
# COPY'd sibling edited WITHOUT touching the Dockerfile text leaves this digest unchanged — run
# `ab rebuild` to re-bake (documented in the README).
build_user_image() {
  local base_tag="$1" force="${2:-}" nocache="${3:-}" mode="${4:-rebuild}" ctx digest child_tag log build_flags
  # The Dockerfile (or a dir on its path) may be a symlink whose target falls outside the build
  # context; BuildKit won't follow such a symlink, so building from the resolved path fails with
  # "failed to read dockerfile: open Dockerfile: no such file or directory". Resolve to the
  # PHYSICAL file/dir (readlink -f) so the context is always real files docker reads directly —
  # works the same whether the path is a symlink or not. (The digest below cats the same path;
  # cat follows any symlink to the real content, so the key still matches what's built.)
  ctx="$(dirname "$(readlink -f "$cfg_dockerfile")")"
  digest="$(printf '%s\n%s\n' "$base_tag" "$(cat "$cfg_dockerfile")" | sha256sum | cut -c1-12)"
  # $hash (from compute_names, the same per-project id cname/dvol use) scopes the tag to THIS
  # project: without it, two projects with different Dockerfiles share one flat
  # "${uid}-custom-*" tag namespace, so pruning one project's stale tag could untag another
  # project's current one (protected only when Docker still has a container pinning it). Scoping
  # by project makes the prune below touch only this project's own tags, never another's.
  child_tag="$IMAGE_NAME:${uid}-custom-${hash}-${digest}"
  if [ "$force" = "force" ] || ! docker image inspect "$child_tag" >/dev/null 2>&1; then
    echo "agentbox: building child image $child_tag (FROM $base_tag) ..." >&2
    # Context = the Dockerfile's physical dir (resolved above); let docker find ./Dockerfile
    # there (the resolved file is always <dir>/Dockerfile). Mirrors how build_image builds base.
    build_flags=(--progress=plain)
    [ "$nocache" = --no-cache ] && build_flags+=(--no-cache)
    policy_final_mutation_guard "$mode" || return 1
    if ! log="$(cd "$ctx" && docker build "${build_flags[@]}" -t "$child_tag" . 2>&1)"; then
      printf '%s\n' "$log" >&2
      echo "agentbox: child image build failed (see above)" >&2
      return 1
    fi
    # Prune stale CHILD tags for THIS PROJECT only (base tags are pruned in build_image; other
    # projects' child tags are a different ${hash} and never matched here). Best-effort, same
    # caveats — a running container referencing an old child image is just untagged. NOTE: at
    # this point in `ab rebuild`, the OLD container (pinning the OLD child tag) is still running —
    # see the re-prune at the tail of `rebuild` in main(), which catches what this one can't yet.
    prune_images "${IMAGE_NAME}:${uid}-custom-${hash}-" "" "$child_tag"
  fi
  printf '%s' "$child_tag"
}

is_running() { [ "$(docker inspect -f '{{.State.Running}}' "$cname" 2>/dev/null || true)" = "true" ]; }
exists() { [ -n "$(docker inspect -f '{{.Id}}' "$cname" 2>/dev/null || true)" ]; }

wait_ready() {
  for _ in $(seq 1 60); do
    docker exec "$cname" docker info >/dev/null 2>&1 && return 0
    sleep 0.5
  done
  echo "agentbox: WARNING — inner docker not ready yet; try 'ab logs'" >&2
  return 1
}

# The entrypoint repairs the ownership of the jj state volume as root, but `docker run -d`
# reports the container running before that startup step completes. Wait until the actual
# runtime user can write the mounted directory so an immediate `ab jj ...`/`ab exec ...` cannot
# race the repair. This is deliberately separate from wait_ready: jj state is required for every
# command, while the inner Docker daemon is allowed to finish coming up asynchronously.
wait_jj_state() {
  for _ in $(seq 1 60); do
    if docker exec --user agentbox "$cname" test -w "$JJ_STATE_CONTAINER" >/dev/null 2>&1; then
      return 0
    fi
    sleep 0.5
  done
  echo "agentbox: jj state directory is not writable yet; try 'ab logs'" >&2
  return 1
}

# Containers created before jj support do not have the state-volume mount at all. Do not send
# those through the readiness loop: tell the user how to recreate them with the current image.
# This check is also used by cmd_exec because a legacy container may already be running.
require_jj_state_mount() {
  exists || return 0
  if ! container_has_mount_destination "$JJ_STATE_CONTAINER"; then
    echo "agentbox: $cname was created before jj state support; run 'ab rebuild' to recreate it." >&2
    return 1
  fi
}

# Shared by ab_parse_mounts_line and ab_parse_network_line: drop a trailing `#` comment, collapse
# internal whitespace, and trim both ends. Both parsers need exactly this before applying their
# own grammar, so it's factored out rather than duplicated.
_ab_strip_comment_and_trim() {
  local s="${1%%#*}"      # drop a trailing # comment
  s="$(printf '%s' "$s" | tr -s '[:space:]' ' ')"                 # collapse whitespace
  s="${s#"${s%%[![:space:]]*}"}"; s="${s%"${s##*[![:space:]]}"}"  # trim ends
  printf '%s' "$s"
}

# Parse one line of the mounts list: print "<src>\t<dst>\t<mode>", or nothing for a comment,
# blank, or malformed line. The grammar is `src [dst] [ro|rw]`, mode defaulting to ro.
#
# Two tokens are ambiguous — `~/notes rw` is src+mode while `~/notes /data` is src+dst — so the
# LAST token is checked against ro/rw first and consumed as the mode when it matches; whatever
# is left is then src, or src+dst. Consequence (documented in the README): a destination
# literally named `ro`/`rw` can't be expressed, and neither can a path containing spaces —
# whitespace is the token separator, the same limitation the `files` list had.
#
# A leading ~ is left literal here and expanded by build_user_mounts (~ -> $HOME on the source
# side, /home/agentbox on the destination side), which keeps this environment-independent for
# tests. Extracted so tests/run.sh can exercise the parse directly (no Docker needed). Always
# returns 0 — the caller runs it in a command substitution under `set -e`, and distinguishes
# "nothing to do" from "malformed" itself (see build_user_mounts).
ab_parse_mounts_line() {
  local s
  s="$(_ab_strip_comment_and_trim "$1")"
  [ -n "$s" ] || return 0
  local a b c extra src dst mode
  read -r a b c extra <<<"$s" || true
  [ -z "$extra" ] || return 0            # 4+ tokens -> malformed
  if [ -n "$c" ]; then                   # src dst mode  (a third token can ONLY be a mode)
    case "$c" in ro | rw) ;; *) return 0 ;; esac
    src="$a"; dst="$b"; mode="$c"
  elif [ -n "$b" ]; then                 # src mode  |  src dst
    case "$b" in
      ro | rw) src="$a"; dst="$a"; mode="$b" ;;
      *) src="$a"; dst="$b"; mode=ro ;;
    esac
  else                                   # src
    case "$a" in ro | rw) return 0 ;; esac   # a bare mode with no path is malformed
    src="$a"; dst="$a"; mode=ro
  fi
  printf '%s\t%s\t%s\n' "$src" "$dst" "$mode"
}

# Parse one line of the networks list: print the docker network name, or nothing for a comment,
# blank, or malformed line. One network name per line (e.g. `lab`); `#` starts a comment.
#
# Docker network names are `[a-zA-Z0-9_.-]+`, so a value outside that set — or starting with `-`,
# which `docker network connect` would read as a flag — is rejected as malformed here rather than
# handed to docker. Mirrors ab_parse_mounts_line's contract: environment-independent (no
# expansion), extracted so tests/run.sh can exercise it directly, and always returns 0 — the
# caller runs it under `set -e` and tells blank/comment from a typo'd line itself (connect_networks).
ab_parse_network_line() {
  local s
  s="$(_ab_strip_comment_and_trim "$1")"
  [ -n "$s" ] || return 0
  case "$s" in
    *[!A-Za-z0-9_.-]* | -*) return 0 ;;   # not a single valid network-name token
    *) printf '%s\n' "$s" ;;
  esac
}

protected_mount_destinations=(
  /workspace
  /workspace/.git
  /usr/bin/git
  /home/agentbox/.gitconfig
  /home/agentbox/.config/git/config
  /home/agentbox/.config/gh
  /home/agentbox/.ssh
  /home/agentbox/.ssh/known_hosts
  /home/agentbox/.config/jj
  /home/agentbox/.jjconfig.toml
  /home/agentbox/.config/jj-host-config.toml
  /home/agentbox/.config/jj-host-conf.d
)

# Normalize a container destination lexically without touching the host filesystem. A leading
# `..` would escape the container root and is rejected instead of being silently clamped to `/`.
canonical_mount_destination() {
  local path="$1" part result="" joined
  [[ "$path" == /* ]] || { policy_fail "mount destination must be absolute: $path"; return 1; }
  local -a components=()
  IFS='/' read -r -a components <<<"$path"
  local -a stack=()
  for part in "${components[@]}"; do
    case "$part" in
      ''|.) continue ;;
      ..)
        [ "${#stack[@]}" -gt 0 ] || { policy_fail "mount destination escapes the container root: $path"; return 1; }
        local last_index=$(( ${#stack[@]} - 1 ))
        unset "stack[$last_index]"
        ;;
      *) stack+=("$part") ;;
    esac
  done
  if [ "${#stack[@]}" -gt 0 ]; then
    joined="$(IFS=/; printf '%s' "${stack[*]}")"
    result="/$joined"
  else
    result=/
  fi
  printf '%s' "$result"
}

mount_destination_obscures_protected() {
  local destination="$1" protected
  [ "$destination" = / ] && { printf '%s' "${protected_mount_destinations[0]}"; return 0; }
  for protected in "${protected_mount_destinations[@]}"; do
    if [ "$destination" = "$protected" ] || [[ "$protected" == "$destination/"* ]]; then
      printf '%s' "$protected"
      return 0
    fi
  done
  return 1
}

validate_custom_mounts() {
  local list="$cfg_mounts" line parsed src dst mode lead protected
  [ -n "$list" ] || return 0
  while IFS= read -r line || [ -n "$line" ]; do
    parsed="$(ab_parse_mounts_line "$line")" || true
    [ -n "$parsed" ] || {
      lead="${line#"${line%%[![:space:]]*}"}"
      case "$lead" in ''|'#'*) ;; *) policy_fail "mounts: malformed line: $line"; return 1 ;; esac
      continue
    }
    src="${parsed%%$'\t'*}"
    dst="${parsed#*$'\t'}"; dst="${dst%%$'\t'*}"
    dst="${dst/#\~//home/agentbox}"
    MOUNT_DESTINATION="$(canonical_mount_destination "$dst")" || return 1
    protected="$(mount_destination_obscures_protected "$MOUNT_DESTINATION" || true)"
    [ -z "$protected" ] || {
      policy_fail "custom mount destination $MOUNT_DESTINATION obscures protected destination $protected"
      return 1
    }
  done < "$list"
}

# Which of ab's own mounts already claims <dst>, if any (printed as the offending spec). A user
# mount onto an occupied destination makes `docker run` fail outright with "Duplicate mount
# point", taking the whole container with it — so build_user_mounts drops that one line instead.
# Handles both spec forms in the array: `-v src:dst[:opts]` and `--mount type=bind,src=…,dst=…`.
# Because user mounts are appended to the same array as they are accepted, this also catches a
# second user line targeting a destination an earlier one already took.
ab_mount_dest_owner() {
  local want="$1" m d
  for m in "${mounts[@]}"; do
    case "$m" in
      -v | --mount) continue ;;
      type=bind,*) d="${m#*,dst=}"; d="${d%%,*}" ;;
      *) d="${m#*:}"; d="${d%%:*}" ;;
    esac
    [ "$d" = "$want" ] && { printf '%s' "$m"; return 0; }
  done
  return 0
}

# Append a `--mount` flag to the mounts array for each line of the resolved `mounts` list, so
# host files and directories appear inside the container without being copied — the container
# sees host-side changes live, and a directory (which the old `files` copy refused) just works.
#
# `--mount` rather than `-v` for these: `-v` CREATES a missing source as a root-owned directory
# on the host, which is exactly the silent mess a typo'd path should not cause, while `--mount`
# errors. Each line is still validated here first so a bad line is named and skipped rather than
# failing the whole `docker run`: the source must be an absolute path that exists, the
# destination must be absolute and unclaimed, and neither may contain a comma (the `--mount`
# option separator, which has no escape).
#
# Called just before `docker run` (not at load time) so the warnings appear when a container is
# actually created, not on every `ab status`. Bind mounts can only be established at create
# time, so edits to the list need `ab destroy && ab start`. No-op without the file.
build_user_mounts() {
  local list="$cfg_mounts"
  [ -n "$list" ] || return 0
  custom_mounts_snapshot_recheck || return 1
  local line parsed rest src dst mode lead owner protected n=0 ok=0
  while IFS= read -r line || [ -n "$line" ]; do
    parsed="$(ab_parse_mounts_line "$line")" || true
    if [ -z "$parsed" ]; then
      # Blank and #-comment lines legitimately yield nothing — stay quiet for those. A line with
      # real content that did not parse is a likely typo: name it (same treatment the entrypoint
      # gives a malformed ports line).
      lead="${line#"${line%%[![:space:]]*}"}"
      case "$lead" in '' | '#'*) ;; *)
        echo "agentbox: mounts: ignoring malformed line: $line (expected 'src [dst] [ro|rw]')" >&2 ;;
      esac
      continue
    fi
    src="${parsed%%$'\t'*}"
    rest="${parsed#*$'\t'}"
    dst="${rest%%$'\t'*}"
    mode="${rest##*$'\t'}"
    src="${src/#\~/$HOME}"            # ~ -> host home
    dst="${dst/#\~//home/agentbox}"   # ~ -> container home
    dst="$(canonical_mount_destination "$dst")" || continue
    protected="$(mount_destination_obscures_protected "$dst" || true)"
    [ -z "$protected" ] || {
      policy_fail "custom mount destination $dst obscures protected destination $protected"
      return 1
    }
    n=$((n+1))
    case "$src$dst" in
      *,*) echo "agentbox: mounts: path contains a comma (unsupported by --mount), skipping: $src" >&2
           continue ;;
    esac
    case "$src" in /*) ;; *)
      echo "agentbox: mounts: source is not an absolute path, skipping: $src" >&2
      continue ;;
    esac
    case "$dst" in /*) ;; *)
      echo "agentbox: mounts: destination is not an absolute path, skipping: $dst" >&2
      continue ;;
    esac
    if [ ! -e "$src" ]; then
      echo "agentbox: mounts: source not found, skipping: $src" >&2
      continue
    fi
    owner="$(ab_mount_dest_owner "$dst")"
    if [ -n "$owner" ]; then
      echo "agentbox: mounts: $dst is already mounted ($owner), skipping: $src" >&2
      continue
    fi
    # readonly is the default; only an explicit `rw` line gets a writable bind. A rw mount lets
    # the agent write to the host path — a deliberate trust grant, so it is reported at start.
    if [ "$mode" = rw ]; then
      mounts+=(--mount "type=bind,src=$src,dst=$dst")
      echo "agentbox: mounts: $src -> $dst (rw — the container can write to this host path)" >&2
    else
      mounts+=(--mount "type=bind,src=$src,dst=$dst,readonly")
    fi
    ok=$((ok+1))
  done < "$list"
  if [ "$n" -gt 0 ]; then
    echo "agentbox: mounts: $ok/$n mount(s) from ${list/#"$HOME"/\~}" >&2
  fi
  return 0
}

# `files` (copy host files in) was replaced by `mounts` (bind them in). Nothing reads a `files`
# list any more; this only ensures a leftover one is reported rather than silently doing nothing
# — the failure mode otherwise is an SSH key that quietly never arrives. The line grammar is
# unchanged, so migrating is a rename.
warn_legacy_files() {
  [ -n "$cfg_files_legacy" ] || return 0
  local shown="${cfg_files_legacy/#"$HOME"/\~}"
  echo "agentbox: $shown is no longer used — \`files\` was replaced by \`mounts\`." >&2
  echo "agentbox:        the line format is the same (plus an optional trailing ro|rw), so:" >&2
  echo "agentbox:          mv $shown ${shown%/*}/mounts" >&2
  return 0
}

# Attach the container to each docker network in the resolved `networks` list. Unlike mounts/env
# (docker-run flags), a network can't be joined at create time from inside a Sysbox container —
# `docker network connect` is an OUTER-daemon op on the container, run AFTER it exists. Hence it
# runs in cmd_start/rebuild once the container is up, NOT as a `docker run` flag.
#
# Already-attached is success (idempotent across `ab start`); other failures warn and continue
# (non-fatal — a missing network shouldn't stop the container). Skipped on cmd_start's
# already-running early return, so adding/changing an entry on a running container needs
# `ab stop && ab start` (a plain `docker start` reuses the prior network set). No-op without the file.
connect_networks() {
  local list="$cfg_networks"
  [ -n "$list" ] || return 0
  local line net members lead n=0 ok=0
  while IFS= read -r line || [ -n "$line" ]; do
    net="$(ab_parse_network_line "$line")" || true
    if [ -z "$net" ]; then
      lead="${line#"${line%%[![:space:]]*}"}"
      case "$lead" in '' | '#'*) ;; *)
        echo "agentbox: networks: ignoring malformed line: $line (expected one network name)" >&2 ;;
      esac
      continue
    fi
    n=$((n+1))
    members="$(docker network inspect "$net" -f '{{range .Containers}}{{.Name}} {{end}}' 2>/dev/null)" || {
      echo "agentbox: networks: no such docker network, skipping: $net" >&2; continue; }
    if printf '%s' "$members" | tr ' ' '\n' | grep -qxF "$cname"; then
      ok=$((ok+1))   # already attached — idempotent, stay quiet
      continue
    fi
    if docker network connect "$net" "$cname" 2>/dev/null; then
      ok=$((ok+1))
      echo "agentbox: networks: attached $cname to $net" >&2
    else
      echo "agentbox: networks: failed to attach $cname to $net (see: docker network connect $net $cname)" >&2
    fi
  done < "$list"
  if [ "$n" -gt 0 ]; then
    echo "agentbox: networks: $ok/$n network(s) attached for $cname" >&2
  fi
  return 0
}

declare -A grant_source_snapshot=()

grant_source_identity() {
  stat -c '%F|%d|%i|%a|%s|%Y' -- "$1" 2>/dev/null
}

grant_source_dir_safe() {
  local path="$1" label="$2"
  [ -d "$path" ] && [ -r "$path" ] && [ -x "$path" ] && [ ! -L "$path" ] || {
    policy_fail "$label grant source must be a readable, searchable, non-symlink directory: $path"
    return 1
  }
}

grant_source_file_safe() {
  local path="$1"
  [ -f "$path" ] && [ -r "$path" ] && [ -w "$path" ] && [ ! -L "$path" ] || {
    policy_fail "SSH known_hosts must be a readable, host-user-writable, non-symlink regular file: $path"
    return 1
  }
}

grant_source_capture_dir() {
  local key="$1" path="$2"
  if [ -L "$path" ]; then grant_source_snapshot["$key"]=symlink
  elif [ ! -e "$path" ]; then grant_source_snapshot["$key"]=absent
  elif [ ! -d "$path" ] || [ ! -r "$path" ] || [ ! -x "$path" ]; then grant_source_snapshot["$key"]=invalid
  else grant_source_snapshot["$key"]="$(grant_source_identity "$path")"; fi
}

grant_source_capture_file() {
  local key="$1" path="$2"
  if [ -L "$path" ]; then grant_source_snapshot["$key"]=symlink
  elif [ ! -e "$path" ]; then grant_source_snapshot["$key"]=absent
  elif [ ! -f "$path" ] || [ ! -r "$path" ] || [ ! -w "$path" ]; then grant_source_snapshot["$key"]=invalid
  else grant_source_snapshot["$key"]="$(grant_source_identity "$path")"; fi
}

grant_sources_validate_snapshot() {
  local value
  if [ "$policy_grant_gh" = 1 ]; then
    value="${grant_source_snapshot[gh]:-invalid}"
    [[ "$value" == directory\|* ]] || {
      policy_fail "GitHub grant source is invalid or changed: $HOME/.config/gh"; return 1;
    }
  fi
  if [ "$policy_grant_all_of_dot_ssh" = 1 ]; then
    value="${grant_source_snapshot[ssh]:-invalid}"
    [[ "$value" == directory\|* ]] || {
      policy_fail "SSH grant source is invalid or changed: $HOME/.ssh"; return 1;
    }
    value="${grant_source_snapshot[known_hosts]:-invalid}"
    if [ "$value" != absent ]; then
      [[ "$value" == regular*\|* ]] || {
        policy_fail "SSH known_hosts source is invalid or changed: $HOME/.ssh/known_hosts"; return 1;
      }
    fi
  fi
}

grant_sources_snapshot() {
  local gh="$HOME/.config/gh" ssh="$HOME/.ssh" known="$HOME/.ssh/known_hosts"
  grant_source_snapshot=()
  grant_source_capture_dir gh "$gh"
  grant_source_capture_dir ssh "$ssh"
  grant_source_capture_file known_hosts "$known"
  grant_sources_validate_snapshot
}

grant_sources_recheck() {
  local path current expected
  [ "${#grant_source_snapshot[@]}" -gt 0 ] || return 0
  [ "$policy_grant_gh" = 1 ] && {
    path="$HOME/.config/gh"; grant_source_dir_safe "$path" "GitHub" || return 1
    current="$(grant_source_identity "$path")"; expected="${grant_source_snapshot[gh]:-}"
    [ "$current" = "$expected" ] || { policy_fail "credential source changed during resolution: $path"; return 1; }
  }
  [ "$policy_grant_all_of_dot_ssh" = 1 ] && {
    path="$HOME/.ssh"; grant_source_dir_safe "$path" "SSH" || return 1
    current="$(grant_source_identity "$path")"; expected="${grant_source_snapshot[ssh]:-}"
    [ "$current" = "$expected" ] || { policy_fail "credential source changed during resolution: $path"; return 1; }
    path="$HOME/.ssh/known_hosts"
    if [ -e "$path" ] || [ -L "$path" ]; then
      grant_source_file_safe "$path" || return 1
      current="$(grant_source_identity "$path")"
    else
      current=absent
    fi
    expected="${grant_source_snapshot[known_hosts]:-}"
    [ "$current" = "$expected" ] || { policy_fail "credential source changed during resolution: $path"; return 1; }
  }
}

# The policy mount specification is the one source of truth for the protected mounts assembled
# below. Keep the keys and their order stable: callers/tests can inspect the complete decision
# without depending on the incidental order of the Docker argument array. An absent source is
# represented by `none`; the git_config destination lists both protected config candidates when
# neither is selected, making the no-Git omission explicit.
mount_spec_keys=(git_blocker git_config github_config ssh_dir known_hosts custom_conflicts)
declare -A mount_spec_source=()
declare -A mount_spec_destination=()
declare -A mount_spec_state=()

mount_spec_reset() {
  local key
  for key in "${mount_spec_keys[@]}"; do
    mount_spec_source["$key"]=none
    mount_spec_destination["$key"]=none
    mount_spec_state["$key"]=absent
  done
  mount_spec_destination[git_blocker]=/usr/bin/git
  mount_spec_destination[git_config]='/home/agentbox/.gitconfig|/home/agentbox/.config/git/config'
  mount_spec_destination[github_config]=/home/agentbox/.config/gh
  mount_spec_destination[ssh_dir]=/home/agentbox/.ssh
  mount_spec_destination[known_hosts]=/home/agentbox/.ssh/known_hosts
}
mount_spec_reset

mount_spec_set() {
  local key="$1" source="$2" destination="$3" state="$4"
  mount_spec_source["$key"]="$source"
  mount_spec_destination["$key"]="$destination"
  mount_spec_state["$key"]="$state"
}

# Print `key<TAB>source<TAB>destination<TAB>state` in the normative fixed order.
mount_spec_record() {
  local key
  for key in "${mount_spec_keys[@]}"; do
    printf '%s\t%s\t%s\t%s\n' \
      "$key" "${mount_spec_source[$key]}" "${mount_spec_destination[$key]}" "${mount_spec_state[$key]}"
  done
}

# Resolve and validate the policy-owned mounts. This function only records decisions; the
# consumer functions append the corresponding Docker arguments after all retry-capable policy
# checks have completed. It deliberately does not create credential sources.
mount_spec_build() {
  local git_source gh_source ssh_source known_hosts_source
  mount_spec_reset

  if [ "$policy_git_enabled" = 1 ]; then
    if [ -f "$HOME/.gitconfig" ]; then
      git_source="$HOME/.gitconfig"
      mount_spec_set git_config "$git_source" /home/agentbox/.gitconfig ro
    elif [ -f "$HOME/.config/git/config" ]; then
      git_source="$HOME/.config/git/config"
      mount_spec_set git_config "$git_source" /home/agentbox/.config/git/config ro
    fi
  else
    validate_git_blocker || return 1
    mount_spec_set git_blocker "$GIT_BLOCKER" /usr/bin/git ro
  fi

  if [ "$policy_grant_gh" = 1 ]; then
    gh_source="$HOME/.config/gh"
    grant_source_dir_safe "$gh_source" "GitHub" || return 1
    mount_spec_set github_config "$gh_source" /home/agentbox/.config/gh rw
  fi

  if [ "$policy_grant_all_of_dot_ssh" = 1 ]; then
    ssh_source="$HOME/.ssh"
    grant_source_dir_safe "$ssh_source" "SSH" || return 1
    mount_spec_set ssh_dir "$ssh_source" /home/agentbox/.ssh ro
    known_hosts_source="$HOME/.ssh/known_hosts"
    if [ -e "$known_hosts_source" ] || [ -L "$known_hosts_source" ]; then
      grant_source_file_safe "$known_hosts_source" || return 1
      mount_spec_set known_hosts "$known_hosts_source" /home/agentbox/.ssh/known_hosts rw
    fi
  fi

  # Custom destinations are validated during policy preflight and rechecked immediately before
  # user mounts are appended. The fixed absent record is the valid mount-spec result; an invalid
  # custom file never reaches Docker argument construction.
}

# Validate the complete mount boundary for callers that are assembling a specification outside
# the normal policy preflight path (the normal path performs this check before Docker inspection).
mount_spec_validate() {
  mount_spec_build || return 1
  if [ -n "${cfg_mounts:-}" ]; then
    validate_custom_mounts || return 1
  fi
}

prepare_host_state() {
  # Docker creates missing -v sources as root-owned directories. Create the state dirs as the
  # invoking user so installed tools can write auth, config, sessions, and history to the host
  # instead of leaving them in the disposable container filesystem.
  mkdir -p "$HOME/.claude" "$HOME/.codex"
  grant_gh="$policy_grant_gh"
  grant_all_of_dot_ssh="$policy_grant_all_of_dot_ssh"
  mount_spec_build
  policy_labels=(
    --label "org.agentbox.policy.version=1"
    --label "org.agentbox.policy.git_enabled=$(policy_bool_text "$policy_git_enabled")"
    --label "org.agentbox.policy.github_grant=$(policy_bool_text "$policy_grant_gh")"
    --label "org.agentbox.policy.ssh_grant_all=$(policy_bool_text "$policy_grant_all_of_dot_ssh")"
    --label "org.agentbox.policy.digest=sha256:$(policy_digest_for "$policy_git_enabled" "$policy_grant_gh" "$policy_grant_all_of_dot_ssh")"
  )
  grant_labels=(
    --label "agentbox.grant-gh=$grant_gh"
    --label "agentbox.grant-all-of-dot-ssh=$grant_all_of_dot_ssh"
    "${policy_labels[@]}"
  )
  if [ "$grant_gh" = 1 ]; then
    [ "${mount_spec_state[github_config]}" = rw ] || {
      policy_fail "GitHub grant mount specification is not writable"; return 1;
    }
    mounts+=(-v "${mount_spec_source[github_config]}:${mount_spec_destination[github_config]}")
  fi
  if [ "$grant_all_of_dot_ssh" = 1 ]; then
    [ "${mount_spec_state[ssh_dir]}" = ro ] || {
      policy_fail "SSH grant mount specification is absent"; return 1;
    }
    mounts+=(-v "${mount_spec_source[ssh_dir]}:${mount_spec_destination[ssh_dir]}:ro")
    # Keep SSH's learned-host state persistent and writable while the rest of the credential
    # directory remains read-only. Missing host files are deliberately not created or mounted.
    if [ "${mount_spec_state[known_hosts]}" = rw ]; then
      mounts+=(-v "${mount_spec_source[known_hosts]}:${mount_spec_destination[known_hosts]}")
    fi
  fi
}

adopt_existing_grants() {
  exists || return 0
  local value
  value="$(docker inspect -f '{{index .Config.Labels "agentbox.grant-gh"}}' "$cname" 2>/dev/null || true)"
  if [ "$value" = 1 ]; then
    grant_gh=1
  fi
  value="$(docker inspect -f '{{index .Config.Labels "agentbox.grant-all-of-dot-ssh"}}' "$cname" 2>/dev/null || true)"
  if [ "$value" = 1 ]; then
    grant_all_of_dot_ssh=1
  fi
}

container_has_mount_destination() {
  docker inspect -f '{{range .Mounts}}{{println .Destination}}{{end}}' "$cname" 2>/dev/null \
    | grep -qxF "$1"
}

container_git_mount_source() {
  docker inspect -f '{{range .Mounts}}{{if eq .Destination "/usr/bin/git"}}{{.Source}}{{end}}{{end}}' "$cname" 2>/dev/null
}

policy_label() {
  local key="$1" value
  value="$(docker inspect -f "{{index .Config.Labels \"$key\"}}" "$cname" 2>/dev/null || true)"
  [ "$value" = '<no value>' ] && value=""
  printf '%s' "$value"
}

policy_inspect_recorded() {
  policy_recorded_status=none
  policy_recorded_git_enabled=""
  policy_recorded_grant_gh=""
  policy_recorded_grant_all_of_dot_ssh=""
  policy_recorded_digest=""
  policy_recorded_detail=""
  exists || return 0

  local version git gh ssh digest old_gh old_ssh expected source blocker_source
  version="$(policy_label org.agentbox.policy.version)"
  git="$(policy_label org.agentbox.policy.git_enabled)"
  gh="$(policy_label org.agentbox.policy.github_grant)"
  ssh="$(policy_label org.agentbox.policy.ssh_grant_all)"
  digest="$(policy_label org.agentbox.policy.digest)"
  if [ -z "$version$git$gh$ssh$digest" ]; then
    # Containers predating policy labels are legacy only when their Git executable state is
    # identifiable. A missing mount means the old launcher-provided Git remains available; the
    # fixed blocker is a recognizable no-Git migration. Any other mount source is ambiguous and
    # must not be silently treated as either enabled or disabled.
    policy_recorded_status=legacy
    if container_has_mount_destination /usr/bin/git; then
      source="$(container_git_mount_source)"
      blocker_source="$(readlink -f "$GIT_BLOCKER" 2>/dev/null || true)"
      if [ -z "$source" ]; then
        policy_recorded_status=invalid
        policy_recorded_detail="legacy container has a /usr/bin/git mount with no inspectable source"
      elif [ "$source" = "$GIT_BLOCKER" ] || {
        [ -n "$blocker_source" ] && [ "$(readlink -f "$source" 2>/dev/null || true)" = "$blocker_source" ];
      }; then
        policy_recorded_git_enabled=0
      else
        policy_recorded_status=invalid
        policy_recorded_detail="legacy container has an unrecognized /usr/bin/git mount source: $source"
      fi
    else
      policy_recorded_git_enabled=1
    fi
    old_gh="$(policy_label agentbox.grant-gh)"
    old_ssh="$(policy_label agentbox.grant-all-of-dot-ssh)"
    case "$old_gh" in ''|0) policy_recorded_grant_gh=0 ;; 1) policy_recorded_grant_gh=1 ;; *) policy_recorded_status=invalid; policy_recorded_detail="old agentbox.grant-gh label is malformed: $old_gh" ;; esac
    case "$old_ssh" in ''|0) policy_recorded_grant_all_of_dot_ssh=0 ;; 1) policy_recorded_grant_all_of_dot_ssh=1 ;; *) policy_recorded_status=invalid; policy_recorded_detail="old agentbox.grant-all-of-dot-ssh label is malformed: $old_ssh" ;; esac
    if [ -z "$old_gh" ] && container_has_mount_destination /home/agentbox/.config/gh; then
      policy_recorded_status=invalid
      policy_recorded_detail="legacy container has a GitHub credential mount but no old grant label"
    elif [ "$old_gh" = 0 ] && container_has_mount_destination /home/agentbox/.config/gh; then
      policy_recorded_status=invalid
      policy_recorded_detail="legacy GitHub grant label is 0 but its credential mount is present"
    elif [ "$old_gh" = 1 ] && ! container_has_mount_destination /home/agentbox/.config/gh; then
      policy_recorded_status=invalid
      policy_recorded_detail="legacy GitHub grant label is 1 but its credential mount is absent"
    fi
    if [ -z "$old_ssh" ] && container_has_mount_destination /home/agentbox/.ssh; then
      policy_recorded_status=invalid
      policy_recorded_detail="legacy SSH grant has a credential mount but no old grant label"
    elif [ "$old_ssh" = 0 ] && container_has_mount_destination /home/agentbox/.ssh; then
      policy_recorded_status=invalid
      policy_recorded_detail="legacy SSH grant label is 0 but its credential mount is present"
    elif [ "$old_ssh" = 1 ] && ! container_has_mount_destination /home/agentbox/.ssh; then
      policy_recorded_status=invalid
      policy_recorded_detail="legacy SSH grant label is 1 but its credential mount is absent"
    fi
    [ -n "$policy_recorded_detail" ] || policy_recorded_detail="no versioned policy labels; migrated from legacy container state"
    return 0
  fi
  if [[ "$version" != 1 || ( "$git" != true && "$git" != false ) || ( "$gh" != true && "$gh" != false ) || ( "$ssh" != true && "$ssh" != false ) || ! "$digest" =~ ^sha256:[0-9a-f]{64}$ ]]; then
    policy_recorded_status=invalid
    policy_recorded_detail="versioned policy labels are incomplete or malformed"
    return 0
  fi
  policy_recorded_git_enabled="$(policy_bool01 "$git")"
  policy_recorded_grant_gh="$(policy_bool01 "$gh")"
  policy_recorded_grant_all_of_dot_ssh="$(policy_bool01 "$ssh")"
  policy_recorded_digest="$digest"
  expected="sha256:$(policy_digest_for "$policy_recorded_git_enabled" "$policy_recorded_grant_gh" "$policy_recorded_grant_all_of_dot_ssh")"
  if [ "$digest" = "$expected" ]; then
    policy_recorded_status=valid
    policy_recorded_detail="versioned labels and digest are consistent"
  else
    policy_recorded_status=stale
    policy_recorded_detail="recorded digest $digest does not match recorded values (expected $expected)"
  fi
}

validate_git_blocker() {
  local mode last
  [ -f "$GIT_BLOCKER" ] && [ ! -L "$GIT_BLOCKER" ] && [ -r "$GIT_BLOCKER" ] && [ -x "$GIT_BLOCKER" ] || {
    policy_fail "Git is disabled but blocker is missing or not readable/executable: $GIT_BLOCKER"; return 1;
  }
  mode="$(stat -c '%a' "$GIT_BLOCKER" 2>/dev/null || true)"
  [ "$mode" = 755 ] || { policy_fail "Git blocker must have mode 0755: $GIT_BLOCKER (has ${mode:-unknown})"; return 1; }
  last="${mode: -1}"
  case "$last" in 2|3|6|7) policy_fail "Git blocker must not be world-writable: $GIT_BLOCKER"; return 1 ;; esac
}

policy_preflight() {
  local mode="$1"
  if [ "${policy_operation_requested:-0}" = 1 ] && [ -z "$agentbox_lock_fd" ]; then
    policy_lock_acquire || return 1
  fi
  policy_load_host || return 1
  # Capture grant source type/identity before any Docker inspection. Recorded grant state may
  # refine the effective value below, so the snapshot includes all three top-level sources.
  if [ "${policy_operation_requested:-0}" = 1 ]; then
    grant_sources_snapshot || return 1
    custom_mounts_snapshot_take || return 1
  fi
  policy_inspect_recorded
  case "$policy_recorded_status" in
    invalid)
      if [ "$policy_apply" != 1 ]; then
        policy_fail "existing container has invalid policy labels; use 'ab start --apply' to reconcile"
        return 1
      fi
      # Explicit apply is the user’s acknowledgement that ambiguous recorded state may be
      # replaced by the newly resolved host policy. Do not infer a grant from malformed metadata.
      policy_recorded_status=stale
      policy_recorded_git_enabled=1
      policy_recorded_grant_gh=0
      policy_recorded_grant_all_of_dot_ssh=0
      ;;
  esac
  # An omitted container policy preserves recorded state. A policy explicitly supplied by CLI,
  # host env, or TOML has already won in policy_load_host. Rebuilds intentionally reset omitted
  # grants to preserve the established `ab rebuild` revoke workflow, but preserve Git state.
  if [ "$policy_git_source" = default ] && [ "$policy_recorded_status" != none ]; then
    policy_git_enabled="$policy_recorded_git_enabled"
    policy_git_source=recorded
  fi
  if [ "$policy_grant_gh_source" = default ]; then
    if [ "$mode" = start ] || [ "$mode" = exec ]; then
      [ "$policy_recorded_status" != none ] && policy_grant_gh="$policy_recorded_grant_gh" && policy_grant_gh_source=recorded
    else
      policy_grant_gh=0
      policy_grant_gh_source=rebuild-default
    fi
  fi
  if [ "$policy_grant_all_of_dot_ssh_source" = default ]; then
    if [ "$mode" = start ] || [ "$mode" = exec ]; then
      [ "$policy_recorded_status" != none ] && policy_grant_all_of_dot_ssh="$policy_recorded_grant_all_of_dot_ssh" && policy_grant_all_of_dot_ssh_source=recorded
    else
      policy_grant_all_of_dot_ssh=0
      policy_grant_all_of_dot_ssh_source=rebuild-default
    fi
  fi
  if [ "${policy_operation_requested:-0}" = 1 ]; then
    grant_sources_validate_snapshot || return 1
  fi
  [ "$policy_git_enabled" = 1 ] || validate_git_blocker || return 1
  if [ "${policy_operation_requested:-0}" = 1 ]; then
    validate_custom_mounts || return 1
  fi
  policy_needs_recreate=0
  if exists; then
    [ "$policy_recorded_status" = valid ] || policy_needs_recreate=1
    if [ "$policy_recorded_status" = valid ]; then
      [ "$policy_recorded_git_enabled" = "$policy_git_enabled" ] || policy_needs_recreate=1
      [ "$policy_recorded_grant_gh" = "$policy_grant_gh" ] || policy_needs_recreate=1
      [ "$policy_recorded_grant_all_of_dot_ssh" = "$policy_grant_all_of_dot_ssh" ] || policy_needs_recreate=1
      [ "$policy_recorded_digest" = "sha256:$(policy_digest_for "$policy_git_enabled" "$policy_grant_gh" "$policy_grant_all_of_dot_ssh")" ] || policy_needs_recreate=1
    fi
    if [ "$policy_needs_recreate" = 1 ] && is_running && [ "$policy_apply" != 1 ]; then
      echo "agentbox: $cname has policy state different from the resolved host policy; refusing to execute or change it while running." >&2
      echo "agentbox: run the explicit apply operation, for example: AGENTBOX_NO_GIT=${policy_git_enabled:+$((1-policy_git_enabled))} ab start --apply" >&2
      return 1
    fi
  fi
}

policy_operation_begin() {
  policy_operation_requested=1
  policy_snapshot_retry_count=0
  policy_lock_acquire
}

policy_resolution_recheck() {
  local mode="$1"
  if policy_snapshot_recheck && grant_sources_recheck && custom_mounts_snapshot_recheck; then return 0; fi
  if [ "${policy_snapshot_retry_count:-0}" = 0 ]; then
    policy_snapshot_retry_count=1
    echo "agentbox: policy source changed during resolution; resnapshotting once" >&2
    grant_source_snapshot=()
    policy_preflight "$mode" || return 1
    policy_snapshot_recheck || {
      policy_fail "policy-changed-during-resolution: ${policy_snapshot_changed_path:-unknown}; retry the operation"
      return 1
    }
    grant_sources_validate_snapshot || return 1
    grant_sources_recheck || return 1
    custom_mounts_snapshot_recheck || {
      policy_fail "policy-changed-during-resolution: ${policy_snapshot_changed_path:-unknown}; retry the operation"
      return 1
    }
    return 0
  fi
  policy_fail "policy-changed-during-resolution: ${policy_snapshot_changed_path:-unknown}; retry the operation"
  return 1
}

policy_final_mutation_guard() {
  local mode="$1"
  [ "${policy_operation_requested:-0}" = 1 ] || return 0
  policy_resolution_recheck "$mode" || return 1
  grant_sources_validate_snapshot || return 1
  grant_sources_recheck || return 1
}

# Check the already-assembled policy mounts without starting another snapshot retry. A retry can
# replace the resolved policy after mounts/labels were built, so the final Docker boundary must
# reject a changed source rather than accept a new snapshot that the existing mount array does not
# represent. Call this immediately before each Docker mutation that consumes those mounts.
policy_final_mount_guard() {
  [ "${policy_operation_requested:-0}" = 1 ] || return 0
  policy_snapshot_recheck || {
    policy_fail "policy-changed-during-resolution: ${policy_snapshot_changed_path:-unknown}; retry the operation"
    return 1
  }
  grant_sources_validate_snapshot || return 1
  grant_sources_recheck || {
    policy_fail "policy-changed-during-resolution: credential source; retry the operation"
    return 1
  }
  custom_mounts_snapshot_recheck || {
    policy_fail "policy-changed-during-resolution: ${policy_snapshot_changed_path:-mounts}; retry the operation"
    return 1
  }
}

check_existing_grants() {
  local spec want path flag
  for spec in "${grant_gh}|/home/agentbox/.config/gh|--grant-gh" \
              "${grant_all_of_dot_ssh}|/home/agentbox/.ssh|--grant-all-of-dot-ssh"; do
    IFS='|' read -r want path flag <<<"$spec"
    if [ "$want" = 1 ] && ! container_has_mount_destination "$path"; then
      echo "agentbox: $cname already exists without $path; run 'ab rebuild $flag' to add it." >&2
      return 1
    elif [ "$want" = 0 ] && container_has_mount_destination "$path"; then
      echo "agentbox: $cname already has $path mounted; run 'ab rebuild' to revoke it." >&2
      return 1
    fi
  done
}

parse_runtime_options() {
  local mode="$1" arg
  shift
  policy_input_begin || return 1
  nocache=""
  policy_apply=0
  grant_gh=0
  grant_all_of_dot_ssh=0
  while [ "$#" -gt 0 ]; do
    arg="$1"
    case "$arg" in
      --no-git) policy_input_set_cli "$arg" ;;
      --grant-gh) policy_input_set_cli "$arg"; grant_gh=1 ;;
      --grant-all-of-dot-ssh) policy_input_set_cli "$arg"; grant_all_of_dot_ssh=1 ;;
      --apply)
        if [ "$mode" != start ]; then
          echo "agentbox: $mode: --apply is only valid with start" >&2
          return 1
        fi
        policy_apply=1
        ;;
      --no-cache)
        if [ "$mode" != rebuild ]; then
          echo "agentbox: $mode: --no-cache is only valid with rebuild" >&2
          return 1
        fi
        nocache=--no-cache
        ;;
      *) echo "agentbox: $mode: unknown option '$arg'" >&2; return 1 ;;
    esac
    shift
  done
}

# Capture policy flags for `ab exec` while preserving the command and its arguments. Policy flags
# are launcher options only when they occur before the command; `--` explicitly ends that prefix.
parse_exec_options() {
  local arg
  shift
  policy_input_begin || return 1
  policy_command_args=()
  while [ "$#" -gt 0 ]; do
    arg="$1"
    case "$arg" in
      --no-git|--grant-gh|--grant-all-of-dot-ssh)
        policy_input_set_cli "$arg"
        shift
        ;;
      --)
        shift
        policy_command_args=("$@")
        return 0
        ;;
      *)
        policy_command_args=("$@")
        return 0
        ;;
    esac
  done
}

# Convenience commands have a fixed first command word (`claude`, `codex`, or `bash`). Capture
# policy flags immediately after it, then preserve the remaining agent arguments verbatim.
parse_convenience_options() {
  local arg
  policy_input_begin || return 1
  policy_command_args=()
  [ "$#" -gt 0 ] || return 0
  policy_command_args+=("$1")
  shift
  while [ "$#" -gt 0 ]; do
    arg="$1"
    case "$arg" in
      --no-git|--grant-gh|--grant-all-of-dot-ssh)
        policy_input_set_cli "$arg"
        shift
        ;;
      --)
        shift
        policy_command_args+=("$@")
        return 0
        ;;
      *)
        policy_command_args+=("$@")
        return 0
        ;;
    esac
  done
}

cmd_start() {
  if [ "${policy_operation_requested:-0}" = 1 ]; then
    policy_resolution_recheck start || exit 1
    grant_sources_validate_snapshot || exit 1
    grant_sources_recheck || exit 1
  fi
  require_sysbox
  require_jj_state_mount
  warn_legacy_files
  if is_running; then
    if [ "$policy_needs_recreate" = 1 ]; then
      echo "agentbox: applying policy to running $cname; active processes and container-local filesystem state will be interrupted." >&2
      # The policy change is expressed entirely by container mounts and labels. Reuse the image
      # already selected by the running container; applying policy must not trigger a tool-image
      # refresh or spend time in a build.
      local tag
      policy_final_mutation_guard start || exit 1
      tag="$(docker inspect -f '{{.Config.Image}}' "$cname" 2>/dev/null || true)"
      [ -n "$tag" ] || { echo "agentbox: cannot apply policy: existing container image is unavailable" >&2; exit 1; }
      # The inspection is read-only, but a source may change between it and mount assembly. Keep
      # the retry-capable check before constructing the replacement's policy mounts.
      policy_final_mutation_guard start || exit 1
    else
      echo "agentbox: $cname is already running."
      wait_jj_state
      return $?
    fi
  else
    local tag
    policy_final_mutation_guard start || exit 1
    tag="$(build_image "" "" start)" || exit 1
    # The image helper has its own pre-build guard; this second check covers a source change after
    # the build returns and before policy mounts/labels are assembled.
    policy_final_mutation_guard start || exit 1
  fi
  if exists && [ "$policy_needs_recreate" = 0 ]; then
    # An existing container keeps the bind mounts it was created with — `mounts` edits only take
    # effect on a fresh `docker run`, hence the `ab destroy && ab start` in the README.
    echo "agentbox: starting $cname ..." >&2
    policy_final_mutation_guard start || exit 1
    docker start "$cname" >/dev/null
  else
    # Build policy mounts only after the last retry-capable image check. If a source changed during
    # the build, policy_final_mutation_guard refreshed the snapshot and these arrays must reflect
    # that refreshed policy rather than the values from the earlier preflight.
    prepare_host_state
    add_policy_mounts
    build_user_mounts   # append --mount flags from the resolved `mounts` list (no-op without)
    policy_final_mount_guard
    exists && docker rm -f "$cname" >/dev/null 2>&1 || true
    echo "agentbox: creating + starting $cname ..." >&2
    policy_final_mount_guard
    docker run -d --name "$cname" "${run_args[@]}" "${grant_labels[@]}" "${mounts[@]}" "$tag" >/dev/null
  fi
  connect_networks   # attach to resolved `networks` (outer-daemon op; no-op without the file)
  # Wait only for the jj state ownership repair. The entrypoint brings inner dockerd up in the
  # background; `ab claude`/`ab exec` do not need to wait for it, and inner-docker callers find
  # it ready shortly after.
  wait_jj_state
}

# Show which config files are in effect for this machine + project, and the search
# that produced them. With four tiers per file, "why is THAT setup.sh running?" is otherwise a
# manual walk of the tree — this answers it in one command, without starting a container.
cmd_config() {
  policy_resolution_recheck config || return 1
  policy_inspect_recorded
  local config_git_enabled="$policy_git_enabled"
  local config_grant_gh="$policy_grant_gh"
  local config_grant_all_of_dot_ssh="$policy_grant_all_of_dot_ssh"
  local config_git_source="$policy_git_source"
  local config_grant_gh_source="$policy_grant_gh_source"
  local config_grant_all_of_dot_ssh_source="$policy_grant_all_of_dot_ssh_source"
  local policy_file
  # `ab start` preserves a container's recorded policy when the host supplied no explicit value.
  # Show that effective start policy here as well, without mutating the resolved host globals or
  # refusing merely because the existing container is stale.
  if [ "$policy_recorded_status" != none ] && [ "$policy_recorded_status" != invalid ]; then
    if [ "$policy_git_source" = default ]; then config_git_enabled="$policy_recorded_git_enabled"; config_git_source=recorded; fi
    if [ "$policy_grant_gh_source" = default ]; then config_grant_gh="$policy_recorded_grant_gh"; config_grant_gh_source=recorded; fi
    if [ "$policy_grant_all_of_dot_ssh_source" = default ]; then config_grant_all_of_dot_ssh="$policy_recorded_grant_all_of_dot_ssh"; config_grant_all_of_dot_ssh_source=recorded; fi
  fi
  echo "agentbox $AB_VERSION"
  local root_note=""
  [ -d "$AB_CFG_ROOT" ] || root_note="   (absent — no per-host config on this machine)"
  echo "machine: $MACHINE"
  echo "project: $PROJECT_DIR"
  echo "root:    ${AB_CFG_ROOT/#"$HOME"/\~}$root_note"
  echo
  echo "policy files (least-specific -> most-specific; field inheritance):"
  local policy_file_count=0
  while IFS= read -r policy_file; do
    if [ -e "$policy_file" ] || [ -L "$policy_file" ]; then
      policy_file_count=$((policy_file_count + 1))
      if policy_file_safe "$policy_file"; then
        printf '  %s\n' "${policy_file/#"$HOME"/\~}"
      else
        printf '  %s (invalid: missing, unreadable, symlink, or world-writable)\n' "${policy_file/#"$HOME"/\~}"
      fi
    fi
  done < <(ab_policy_candidates "$AB_CFG_ROOT" "$MACHINE" "$PROJECT_DIR")
  [ "$policy_file_count" -gt 0 ] || echo "  (none — built-in defaults apply)"
  echo
  echo "policy:"
  printf '  %-18s %s (source: %s)\n' "git.enabled" "$([ "$config_git_enabled" = 1 ] && echo true || echo false)" "$config_git_source"
  printf '  %-18s %s (source: %s)\n' "github.grant" "$([ "$config_grant_gh" = 1 ] && echo true || echo false)" "$config_grant_gh_source"
  printf '  %-18s %s (source: %s)\n' "ssh.grant_all" "$([ "$config_grant_all_of_dot_ssh" = 1 ] && echo true || echo false)" "$config_grant_all_of_dot_ssh_source"
  printf '  %-18s %s (source: %s)\n' "updates.check" "$([ "$policy_updates_check" = 1 ] && echo true || echo false)" "$policy_updates_source"
  printf '  recorded container: %s%s\n' "$policy_recorded_status" \
    "${policy_recorded_detail:+ — $policy_recorded_detail}"
  if [ "$policy_recorded_status" = valid ] || [ "$policy_recorded_status" = stale ] || [ "$policy_recorded_status" = legacy ]; then
    printf '  recorded values:    git=%s github=%s ssh=%s digest=%s\n' \
    "$([ "$policy_recorded_git_enabled" = 1 ] && echo true || echo false)" \
    "$([ "$policy_recorded_grant_gh" = 1 ] && echo true || echo false)" \
    "$([ "$policy_recorded_grant_all_of_dot_ssh" = 1 ] && echo true || echo false)" "${policy_recorded_digest:-none}"
    if [ "$config_git_enabled" != "$policy_recorded_git_enabled" ]; then
      printf '  delta: git.enabled effective=%s recorded=%s\n' "$([ "$config_git_enabled" = 1 ] && echo true || echo false)" "$([ "$policy_recorded_git_enabled" = 1 ] && echo true || echo false)"
    fi
    if [ "$config_grant_gh" != "$policy_recorded_grant_gh" ]; then
      printf '  delta: github.grant effective=%s recorded=%s\n' "$([ "$config_grant_gh" = 1 ] && echo true || echo false)" "$([ "$policy_recorded_grant_gh" = 1 ] && echo true || echo false)"
    fi
    if [ "$config_grant_all_of_dot_ssh" != "$policy_recorded_grant_all_of_dot_ssh" ]; then
      printf '  delta: ssh.grant_all effective=%s recorded=%s\n' "$([ "$config_grant_all_of_dot_ssh" = 1 ] && echo true || echo false)" "$([ "$policy_recorded_grant_all_of_dot_ssh" = 1 ] && echo true || echo false)"
    fi
    config_digest="sha256:$(policy_digest_for "$config_git_enabled" "$config_grant_gh" "$config_grant_all_of_dot_ssh")"
    if [ "$policy_recorded_status" != legacy ] && [ "$config_digest" != "$policy_recorded_digest" ]; then
      printf '  delta: policy.digest effective=%s recorded=%s\n' "$config_digest" "$policy_recorded_digest"
    elif [ "$policy_recorded_status" = legacy ]; then
      echo "  delta: policy.digest effective=$config_digest recorded=none (legacy; recreation will add it)"
    else
      echo "  delta: none"
    fi
  elif [ "$policy_recorded_status" = invalid ]; then
    echo "  delta: unavailable until the invalid recorded policy is explicitly reconciled"
  fi
  echo
  echo "in effect:"
  printf '  %-11s %s\n' "env"        "$(ab_config_show "$cfg_env")"
  printf '  %-11s %s\n' "mounts"     "$(ab_config_show "$cfg_mounts")"
  printf '  %-11s %s\n' "ports"      "$(ab_config_show "$cfg_ports")"
  printf '  %-11s %s\n' "setup.sh"   "$(ab_config_show "$cfg_setup")"
  printf '  %-11s %s\n' "networks"   "$(ab_config_show "$cfg_networks")"
  printf '  %-11s %s\n' "dockerfile" "$(ab_config_show_dockerfile "$cfg_dockerfile")"
  echo
  echo "search order (first match wins; each of env, mounts, ports, setup.sh, networks, dockerfile separately):"
  ab_config_candidates "${AB_CFG_ROOT/#"$HOME"/\~}" "$MACHINE" "$PROJECT_DIR" '<name>' | sed 's/^/  /'
  # A leftover `files` is not config any more — surface it here too, not just at `ab start`.
  if [ -n "$cfg_files_legacy" ]; then
    echo
    warn_legacy_files
  fi
}

# Create the directory for one config tier and optionally drop starter templates into it — the
# two manual steps (`mkdir -p` the exact nested path, `cp` the right example) that make setting
# up a first per-machine/per-project override tedious. --machine/--project select the tier the
# same way the four-tier search does (see ab_config_candidates); neither flag means the plain
# top-level (global) tier. Reuses ab_config_candidates itself (rather than re-deriving the path)
# so the directory this creates can never drift from what the search actually resolves.
cmd_config_init() {
  local want_machine=0 want_project=0
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --machine) want_machine=1; shift ;;
      --project) want_project=1; shift ;;
      --) shift; break ;;
      -*) echo "agentbox: config init: unknown flag '$1' (expected --machine / --project)" >&2; exit 1 ;;
      *) break ;;
    esac
  done
  local line   # which of ab_config_candidates' 4 printed lines (most-specific first) is ours
  if [ "$want_machine" = 1 ] && [ "$want_project" = 1 ]; then line=1
  elif [ "$want_machine" = 1 ]; then line=2
  elif [ "$want_project" = 1 ]; then line=3
  else line=4
  fi
  local dir
  # A dummy name ('.') so the last path component is stripped below — ab_config_candidates
  # always appends <name>, so this is the one call that asks it for a directory, not a file.
  dir="$(ab_config_candidates "$AB_CFG_ROOT" "$MACHINE" "$PROJECT_DIR" '.' | sed -n "${line}p")"
  dir="${dir%/.}"
  mkdir -p "$dir"
  echo "agentbox: config dir ready: ${dir/#"$HOME"/\~}"

  local f copied=0
  for f in "$@"; do
    case "$f" in
      env | mounts | ports | setup.sh | networks | Dockerfile) ;;
      *)
        echo "agentbox: config init: unknown file '$f' (expected env|mounts|ports|setup.sh|networks|Dockerfile)" >&2
        continue
        ;;
    esac
    local dst="$dir/$f"
    if [ -e "$dst" ]; then
      echo "agentbox: config init: $f already exists, not overwriting: $dst" >&2
      continue
    fi
    cp "$CONTEXT/examples/agentbox-config/$f" "$dst"
    copied=$((copied + 1))
    echo "agentbox: config init: wrote $dst (starter template — edit it)"
  done
  if [ "$#" -gt 0 ]; then
    echo "agentbox: config init: $copied/$# template(s) written"
  else
    echo "agentbox: config init: pass file names (env mounts ports setup.sh networks Dockerfile)" >&2
    echo "agentbox:              to also drop starter templates into $dir" >&2
  fi
  echo
  echo "agentbox: run 'ab config' to see what's now in effect for this machine/project."
  return 0
}

# Append the invoking shell's current values for exactly the variables declared by the
# resolved env file. The container's Config.Env is fixed at docker run time, but values such as
# STAY_SESSION_NAME are session-specific; overlaying them on every docker exec keeps each command
# aligned with the shell that launched it without leaking unrelated host variables.
ab_append_current_env() {
  local -n target_args="$1"
  [ -n "$cfg_env" ] || return 0

  local line name
  while IFS= read -r line || [ -n "$line" ]; do
    line="${line#"${line%%[![:space:]]*}"}"
    line="${line%"${line##*[![:space:]]}"}"
    case "$line" in
      '' | '#'* ) continue ;;
    esac

    name="${line%%=*}"
    name="${name%"${name##*[![:space:]]}"}"
    [[ "$name" =~ ^[a-zA-Z_][a-zA-Z0-9_]*$ ]] || continue
    # A bare declaration imports the launching shell's value when present. An unset
    # variable is a normal skip, not a failure — especially when this is the last
    # declaration in the file, since the helper runs under set -e in cmd_exec.
    if [[ -v "$name" ]]; then
      target_args+=(--env "$name=${!name}")
    fi
  done < "$cfg_env"
  return 0
}

cmd_exec() {
  if [ "${policy_operation_requested:-0}" = 1 ]; then
    policy_resolution_recheck exec || exit 1
    grant_sources_validate_snapshot || exit 1
    grant_sources_recheck || exit 1
  fi
  require_jj_state_mount
  is_running || cmd_start
  # Covers a concurrent `ab start`, or a container started directly with `docker start`, where
  # cmd_start was not the process that waited for the entrypoint's jj ownership repair.
  wait_jj_state
  # No command (or a bare `bash`) → an interactive shell. Interactive non-login bash
  # sources ~/.bashrc on startup, which is where claude()/codex() are defined.
  if [ "$#" -eq 0 ] || { [ "$#" -eq 1 ] && [ "$1" = bash ]; }; then
    # -i keeps stdin open (so a piped command reaches the shell); -t only when stdin IS a
    # terminal — forcing -t under a pipe makes docker fail "the input device is not a TTY"
    # (e.g. `echo x | ab exec bash`). Source ~/.bashrc via BASH_ENV too, so claude()/codex()
    # are defined even without a tty: an interactive shell sources it directly and ignores
    # BASH_ENV, while a non-interactive one sources BASH_ENV instead (one way or the other,
    # the wrappers are present). Mirrors the -t gating of the command path below.
    local shell_args=(docker exec --user agentbox -i -e BASH_ENV=/home/agentbox/.bashrc)
    ab_append_current_env shell_args
    [ -t 0 ] && shell_args+=(-t)
    exec "${shell_args[@]}" "$cname" bash
  fi
  # Run the command so ~/.bashrc is ALWAYS applied — that's where claude()/codex() live,
  # the functions that inject --dangerously-skip-permissions /
  # --dangerously-bypass-approvals-and-sandbox. Without them `ab exec claude` runs the raw
  # binary (no bypass → it prompts on every tool use → unusable headless). `bash -ic` can't
  # do this: an interactive shell with no TTY spews "cannot set terminal process group / no
  # job control" and makes `docker exec -t` fail with "the input device is not a TTY" under
  # any pipe/CI. So source ~/.bashrc from a NON-interactive `bash -c` via BASH_ENV instead:
  # the functions get defined cleanly in every case (TTY or not), with no startup noise.
  # (.bashrc has no "if not interactive, return" guard, so its defs are reached this way.)
  #
  # -i is unconditional (keeps stdin open so pipes reach the command: `echo x | ab exec cat`).
  # -t is added only when stdin IS a terminal — docker's "the input device is not a TTY"
  # failure is specifically about stdin (fd 0), so gating on [ -t 0 ] is exactly what avoids
  # the crash while still giving claude/codex a real TTY for their TUI when run from a
  # terminal. printf '%q' rebuilds the args as one safely-quoted string so the FIRST word
  # stays a literal token — function lookup resolves a literal `claude`/`codex` to the wrapper
  # (e.g. `ab claude --resume` → claude() → --dangerously-skip-permissions --resume), never
  # the bare binary.
  local exec_args=(docker exec --user agentbox -i -e BASH_ENV=/home/agentbox/.bashrc)
  ab_append_current_env exec_args
  [ -t 0 ] && exec_args+=(-t)
  exec "${exec_args[@]}" "$cname" bash -c "$(printf '%q ' "$@")"
}

main() {
  # Keep help/version static. Every other command parses/resolves policy before the courtesy
  # update check, so invalid policy/options never trigger network access.
  case "${1:-}" in
  start)
    shift; parse_runtime_options start "$@"
    policy_operation_begin || exit 1
    policy_preflight start
    policy_resolution_recheck start || exit 1
    [ "$policy_updates_check" = 1 ] && check_for_update
    cmd_start
    ;;
  stop)
    policy_operation_begin || exit 1
    policy_load_host; [ "$policy_updates_check" = 1 ] && check_for_update
    if exists; then docker stop "$cname" >/dev/null && echo "agentbox: stopped $cname (kept; 'ab destroy' to remove)"; else echo "agentbox: $cname does not exist"; fi
    ;;
  destroy)
    policy_operation_begin || exit 1
    policy_load_host; [ "$policy_updates_check" = 1 ] && check_for_update
    # Attempt BOTH removals independently and report every failure: a failed container rm
    # must not skip the volume rm (or vice versa). Exit non-zero if either failed so a
    # partial failure isn't masked (e.g. by `ab destroy && ab start`). Explicit ifs, not
    # `A && B || true` — that form trips shellcheck SC2015 ("C may run when A is true").
    if ! exists; then
      echo "agentbox: $cname does not exist"
    else
      rc=0
      if docker rm -f "$cname" >/dev/null 2>&1; then
        echo "agentbox: removed $cname"
      else
        echo "agentbox: failed to remove container $cname (see: docker rm -f $cname)" >&2
        rc=1
      fi
      if docker volume rm "$dvol" >/dev/null 2>&1; then
        echo "agentbox: removed inner-docker volume $dvol"
      else
        echo "agentbox: failed to remove inner-docker volume $dvol (it may still be in use)" >&2
        rc=1
      fi
      # jvol was added after the inner-docker volume. It is optional for older containers, so
      # an absent volume is a successful no-op rather than a failed destroy.
      if docker volume inspect "$jvol" >/dev/null 2>&1; then
        if docker volume rm "$jvol" >/dev/null 2>&1; then
          echo "agentbox: removed jj state volume $jvol"
        else
          echo "agentbox: failed to remove jj state volume $jvol (it may still be in use)" >&2
          rc=1
        fi
      fi
      exit "$rc"
    fi
    ;;
  status)
    policy_operation_begin || exit 1
    policy_load_host; [ "$policy_updates_check" = 1 ] && check_for_update
    is_running && echo "running: $cname" || echo "not running: $cname"
    ;;
  config)
    policy_operation_begin || exit 1
    policy_load_host; grant_sources_snapshot || exit 1; [ "$policy_updates_check" = 1 ] && check_for_update
    shift
    if [ "${1:-}" = init ]; then
      shift
      cmd_config_init "$@"
    else
      cmd_config
    fi
    ;;
  logs)
    policy_operation_begin || exit 1
    policy_load_host; [ "$policy_updates_check" = 1 ] && check_for_update
    docker logs --tail 80 "$cname" 2>&1 | tail -80
    ;;
  exec)
    shift
    parse_exec_options exec "$@"
    policy_operation_begin || exit 1
    policy_preflight exec
    policy_resolution_recheck exec || exit 1
    [ "$policy_updates_check" = 1 ] && check_for_update
    cmd_exec "${policy_command_args[@]}"
    ;;
  build | rebuild)
    shift
    parse_runtime_options rebuild "$@"
    policy_operation_begin || exit 1
    policy_preflight rebuild
    policy_resolution_recheck rebuild || exit 1
    [ "$policy_updates_check" = 1 ] && check_for_update
    require_sysbox
    policy_final_mutation_guard rebuild || exit 1
    tag="$(build_image force "$nocache")" || exit 1
    policy_final_mutation_guard rebuild || exit 1
    prepare_host_state
    add_policy_mounts
    build_user_mounts   # append --mount flags from the resolved `mounts` list (no-op without)
    warn_legacy_files
    echo "agentbox: recreating $cname with $tag ..." >&2
    policy_final_mount_guard
    docker rm -f "$cname" >/dev/null 2>&1 || true
    policy_final_mount_guard
    docker run -d --name "$cname" "${run_args[@]}" "${grant_labels[@]}" "${mounts[@]}" "$tag" >/dev/null
    connect_networks   # attach to resolved `networks` (outer-daemon op; no-op without the file)
    wait_ready
    # Re-prune this project's child tags now that the old container (which pinned the superseded
    # one) is gone — build_user_image's own prune above ran BEFORE `docker rm -f` and so couldn't
    # remove it. Unconditional (not gated on $tag being a child tag): the ${hash} scoping means
    # this only ever matches THIS project's own "${uid}-custom-${hash}-*" tags, so it's always
    # safe to run, and it MUST run even when $tag is the base tag — that's exactly the case where
    # a Dockerfile was just removed/emptied, and the child tag it built is now permanently orphaned
    # unless this sweep catches it (nothing else ever will: build_user_image's own prune only runs
    # when a Dockerfile is resolved, and `ab destroy` doesn't touch images at all).
    prune_images "${IMAGE_NAME}:${uid}-custom-${hash}-" "" "$tag"
    ;;
  # Help = this header comment block, with the leading `# ` stripped, printed as-is
  # (stops at the first non-comment line, so code is never shown).
  "" | -h | --help) awk 'NR>1 && /^#/{sub(/^#?/,""); print; next} NR>1{exit}' "$0" ;;
  --version) echo "agentbox $AB_VERSION"; exit 0 ;;
  *) parse_convenience_options "$@"; policy_operation_begin || exit 1; policy_preflight exec; policy_resolution_recheck exec || exit 1; [ "$policy_updates_check" = 1 ] && check_for_update; cmd_exec "${policy_command_args[@]}" ;;
  esac
}

# Run only when executed directly, not when sourced — so tests/run.sh can source this file
# and call compute_names() (and friends) without triggering any docker command.
if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
  main "$@"
fi
