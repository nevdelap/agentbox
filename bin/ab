# Task 6's decision record is the only command-facing policy gate.  Task 7 may populate the
# operation/readiness overlay before calling policy_decide; the defaults deliberately mean that
# no operation record exists, rather than guessing from the container's lifecycle state.
policy_operation_status="none"
policy_readiness_result="not-applicable"
policy_decision_kind=""
policy_decision_reason_code=""
policy_decision_mutation_allowed=0
policy_decision_execution_allowed=0
policy_decision_explicit_exec_mode="blocked"
policy_decision_update_allowed=0
