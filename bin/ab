#!/usr/bin/env bash
#
# ab — Claude Code / Codex in a long-lived, **Sysbox-confined** agentbox container.
#
# agentbox is launched with `docker run --runtime=sysbox-runc`: Sysbox isolates the
# container so the inner Docker daemon (rootful, in-container) cannot reach the host —
# nested Docker with no --privileged and no host docker socket.
#
#   ab start                 create + start the container for the current project
#   ab stop                  stop it (kept on disk; /tmp build state preserved)
#   ab destroy               stop + remove it (destroyed; /tmp build state lost)
#   ab status                show whether the container is running
#   ab config                show which per-machine/per-project config files are in effect
#   ab logs                  tail the container / inner-dockerd logs
#   ab claude [args...]      docker exec claude as the agentbox user (auto-starts if not started)
#   ab codex  [args...]      docker exec codex
#   ab bash                  docker exec bash
#   ab exec <cmd...>         docker exec an arbitrary command (as agentbox)
#   ab rebuild               rebuild the image and recreate the running container
#
# Each project path gets its own container (and its own inner-docker data root), so
# per-container state — notably CARGO_TARGET_DIR=/tmp/target — persists across ab
# invocations until `ab destroy`.
#
# Host prerequisite: Sysbox must be installed + registered as a docker runtime
# (see README.md). `ab start` checks for it and bails with guidance if missing.
#
set -euo pipefail

IMAGE_NAME="agentbox"

# Resolve the agentbox repo root (the dir holding the Dockerfile) from this script's
# real location — works whether `ab` is run in place or reached via a symlink on PATH
# (e.g. ~/.bin/ab -> .../agentbox/bin/ab). Override with $AGENTBOX_CONTEXT if needed.
_self="$(readlink -f "${BASH_SOURCE[0]}")"
CONTEXT="${AGENTBOX_CONTEXT:-$(cd "$(dirname "$_self")/.." && pwd)}"

PROJECT_DIR="${AGENTBOX_DIR:-$PWD}"
PROJECT_DIR="$(cd "$PROJECT_DIR" && pwd)" || {
  echo "ab: project dir not found: ${AGENTBOX_DIR:-$PWD}" >&2
  exit 1
}

# Names unique to the FULL project path (not just the dir name): the same basename in
# two parents (~/a/foo, ~/b/foo) must get distinct containers + volumes. We fold the
# path into a readable slug (so `docker ps` shows which project) and append a long
# sha256 substring so even truncated/deep paths never collide.
# Extracted into a function so the unit tests (tests/run.sh) can source this file and
# exercise the derivation directly.
compute_names() {
  local dir="$1"
  slug="$(printf '%s' "$dir" | tr -cs '[:alnum:]' '-' | sed 's/^-\+//')"
  slug="${slug:0:80}"
  hash="$(printf '%s' "$dir" | sha256sum | cut -c1-16)"
  cname="agentbox-${slug}-${hash}"       # one container per project path
  dvol="agentbox-docker-${slug}-${hash}" # ...and its own inner-docker data root
}
compute_names "$PROJECT_DIR"
uid="$(id -u)"

# --- per-machine / per-project config resolution --------------------------------
# The four optional config files (env, files, ports, setup.sh) are each resolved separately, so
# one ~/.config/agentbox tree — checked in and shared across machines — can hold a global
# default plus per-machine, per-project, and per-machine-per-project overrides.
AB_CFG_ROOT="$HOME/.config/agentbox"
AB_CFG_CONTAINER=/home/agentbox/.config/agentbox
# The machine name keying the search. Defaults to the host's name (the same value ab gives the
# container via --hostname); AGENTBOX_MACHINE overrides it, so a machine can be renamed — or a
# rename rehearsed — without moving directories. It deliberately does NOT change --hostname.
MACHINE="${AGENTBOX_MACHINE:-$(hostname)}"

# The four candidate paths for one config file <name>, most specific first: this project on this
# machine, this machine (any project), this project (any machine), then the plain top-level file
# — which is exactly the pre-per-project behaviour, so an existing flat config keeps working
# untouched. `machines/` and `projects/` are reserved directory names at the config root: without
# them a machine called `home` would be indistinguishable from the first segment of a project
# path like /home/nevd/myproj, and the search would silently resolve the ambiguity the wrong way.
# The project component is its absolute path with the leading slash dropped
# (/home/nevd/myproj -> home/nevd/myproj). Pure (no filesystem access) and parameterised on the
# root, so tests/run.sh can exercise the ordering directly.
ab_config_candidates() {
  local root="$1" machine="$2" proj="${3#/}" name="$4"
  printf '%s\n' \
    "$root/machines/$machine/projects/$proj/$name" \
    "$root/machines/$machine/$name" \
    "$root/projects/$proj/$name" \
    "$root/$name"
}

# First existing candidate for <name> (same args as ab_config_candidates), or nothing when none
# of the four exist. Only regular files count — a directory sitting at a candidate path is
# skipped, not treated as a match. Always returns 0: callers run it in a command substitution
# under `set -e`, and "no config file" is a normal, silent outcome (all four are optional).
ab_config_file() {
  local c
  while IFS= read -r c; do
    if [ -f "$c" ]; then
      printf '%s' "$c"
      return 0
    fi
  done < <(ab_config_candidates "$@")
  return 0
}

# Container-side path of a resolved config file. The whole config root is bind-mounted ro at
# $AB_CFG_CONTAINER, so any resolved path maps by swapping that prefix. Empty in -> empty out
# (nothing resolved, nothing to pass).
ab_config_container_path() {
  local p="$1"
  [ -n "$p" ] || return 0
  printf '%s' "$AB_CFG_CONTAINER${p#"$AB_CFG_ROOT"}"
}

# How `ab config` renders one resolved path: "(none)" when nothing matched, else the path with
# $HOME abbreviated to ~ (these are long, and the tier that won is the part worth reading).
ab_config_show() {
  if [ -z "$1" ]; then printf '(none)'; else printf '%s' "${1/#"$HOME"/\~}"; fi
}

# Resolve all four once, up front: `ab config` prints them, and cmd_start/build_user_mounts/
# run_args below consume them. Empty string = "no such config file on this host for this project".
# cfg_files_legacy is NOT a config file — `files` was replaced by `mounts`, and this only exists
# so a leftover `files` is reported instead of silently ignored (see warn_legacy_files).
cfg_env=""
cfg_mounts=""
cfg_ports=""
cfg_setup=""
cfg_files_legacy=""
if [ -d "$AB_CFG_ROOT" ]; then
  cfg_env="$(ab_config_file "$AB_CFG_ROOT" "$MACHINE" "$PROJECT_DIR" env)"
  cfg_mounts="$(ab_config_file "$AB_CFG_ROOT" "$MACHINE" "$PROJECT_DIR" mounts)"
  cfg_ports="$(ab_config_file "$AB_CFG_ROOT" "$MACHINE" "$PROJECT_DIR" ports)"
  cfg_setup="$(ab_config_file "$AB_CFG_ROOT" "$MACHINE" "$PROJECT_DIR" setup.sh)"
  cfg_files_legacy="$(ab_config_file "$AB_CFG_ROOT" "$MACHINE" "$PROJECT_DIR" files)"
fi

mounts=(
  -v "$PROJECT_DIR:/workspace"
  -v "$HOME/.claude:/home/agentbox/.claude"
  -v "$HOME/.codex:/home/agentbox/.codex"
  -v "$dvol:/var/lib/docker"
)
# Optional host files/dirs mirrored in only when present (existence-guarded).
# ~/.claude.json carries the oauthAccount/userID Claude Code checks at startup to
# consider itself logged in — without it the container has an empty stub and prompts
# for login, even though ~/.claude/.credentials.json (the token) is mounted above.
[ -f "$HOME/.claude.json" ] && mounts+=(-v "$HOME/.claude.json:/home/agentbox/.claude.json")
[ -f "$HOME/.gitconfig" ] && mounts+=(-v "$HOME/.gitconfig:/home/agentbox/.gitconfig:ro")
# Optional + existence-guarded. On hosts that manage ~/.bin via home-manager, its entries
# are /nix/store copies (resolved inside the container by the /nix/store ro mount above) or
# symlinks into this source tree, so the tree is mounted to keep those symlinks resolvable
# inside the container. Both are read-only: the agent must NOT be able to write back to the
# host's dotfile source or drop scripts in ~/.bin (confinement). Reading/executing still works;
# only writes are blocked. The guard skips them entirely on hosts without the dirs.
[ -d "$HOME/.config/home-manager" ] && mounts+=(-v "$HOME/.config/home-manager:/home/agentbox/.config/home-manager:ro")
[ -d "$HOME/.bin" ] && mounts+=(-v "$HOME/.bin:/home/agentbox/.bin:ro")
[ -e /etc/localtime ] && mounts+=(-v "/etc/localtime:/etc/localtime:ro")
# NixOS only: expose the nix store read-only so /nix/store shebangs & paths in the
# workspace resolve inside the container.
[ -d /nix/store ] && mounts+=(-v "/nix/store:/nix/store:ro")
if [ "${AGENTBOX_SSH:-0}" = "1" ] && [ -d "$HOME/.ssh" ]; then
  mounts+=(-v "$HOME/.ssh:/home/agentbox/.ssh:ro")
fi

# Sysbox provides the confinement — the outer container needs NO capabilities, no
# seccomp relaxation, no devices. The run flags are the `sysbox-runc` runtime (registered
# on the host) and `--init`. `--init` inserts docker's bundled init (tini) as PID 1 so the
# entrypoint's backgrounded children — the per-port socat forwarders and the setup.sh
# subshell — get reaped instead of accumulating as zombies under the `tail -f /dev/null`
# that otherwise holds the foreground. The inner dockerd runs rootful-in-container, isolated
# by Sysbox; tooling runs as the unprivileged agentbox user via `docker exec --user`.
run_args=(
  --runtime=sysbox-runc
  --init                     # tini as PID 1 reaps the entrypoint's backgrounded children
  --hostname "$(hostname)"   # in-container hostname matches the real host
  -w /workspace
)

# Optional per-host customization dir (~/.config/agentbox). Absent → no-op (other machines are
# unaffected). Present → mount it ro, let the container reach declared host services over the
# docker host gateway, and pass an env file. `--add-host=…:host-gateway` is only a /etc/hosts
# entry — it grants the container NO capability, so the Sysbox confinement is intact (we do
# NOT use --network host). The WHOLE tree is mounted (not just the resolved files), so the
# entrypoint can read whichever `ports` / `setup.sh` won the search; ab tells it which via the
# two AGENTBOX_*_FILE env vars, as container-side paths under the mount. Those are set at
# container CREATE time, so adding a *more specific* ports/setup.sh later needs
# `ab destroy && ab start` — editing the contents of the one already in effect does not (it is
# read live from the mount). See README "Per-host and per-project customization".
if [ -d "$AB_CFG_ROOT" ]; then
  mounts+=(-v "$AB_CFG_ROOT:$AB_CFG_CONTAINER:ro")
  run_args+=(--add-host=host.docker.internal:host-gateway)
  [ -n "$cfg_env" ] && run_args+=(--env-file "$cfg_env")
  [ -n "$cfg_ports" ] && run_args+=(-e "AGENTBOX_PORTS_FILE=$(ab_config_container_path "$cfg_ports")")
  [ -n "$cfg_setup" ] && run_args+=(-e "AGENTBOX_SETUP_FILE=$(ab_config_container_path "$cfg_setup")")
fi

# Fail fast with guidance if the host hasn't got Sysbox registered.
require_sysbox() {
  if ! docker info 2>/dev/null | grep -q 'sysbox-runc'; then
    cat >&2 <<EOF
ab: host Docker has no 'sysbox-runc' runtime registered.
agentbox needs Sysbox installed on the host (a prerequisite, like Docker itself):
  - Ubuntu:  sudo bash "$CONTEXT/install-sysbox-ubuntu.sh"
  - NixOS:   copy "$CONTEXT/sysbox.nix" to /etc/nixos, import it, then
             sudo nixos-rebuild switch
See "$CONTEXT/README.md" (Host prerequisite).
Then retry.
EOF
    exit 1
  fi
}

build_image() {
  local force="${1:-}" files=() f digest tag log
  [ -f "$CONTEXT/Dockerfile" ] || {
    echo "ab: Dockerfile not found at $CONTEXT/Dockerfile" >&2
    exit 1
  }
  for f in Dockerfile agentbox-entrypoint.sh .bashrc .dockerignore; do
    [ -f "$CONTEXT/$f" ] && files+=("$CONTEXT/$f")
  done
  # Fold the build args `ab` actually varies into the freshness digest, not just the file
  # contents — so a change to HOST_UID/HOST_GID invalidates the cached image instead of
  # silently reusing a tag built for different args. (CLAUDE_CHANNEL/CODEX_RELEASE aren't
  # passed here today — the Dockerfile defaults apply — so pinning them still requires a
  # direct `docker build`; that path never consults this digest.)
  digest="$( { cat "${files[@]}"; printf 'HOST_UID=%s\nHOST_GID=%s\n' "$uid" "$(id -g)"; } | sha256sum | cut -c1-12)"
  tag="$IMAGE_NAME:${uid}-${digest}"
  if [ "$force" = "force" ] || ! docker image inspect "$tag" >/dev/null 2>&1; then
    echo "ab: building $tag ..." >&2
    # Capture the full build log and print it ONLY on failure (silent on success).
    # --progress=plain keeps the captured output linear/readable (no progress-bar
    # redraws) for when it is shown. Capturing into $log (not raw stdout) also keeps the
    # image ID out of the tag this function returns — the cause of the earlier
    # --quiet "invalid reference format" bug.
    if ! log="$(docker build --progress=plain \
        --build-arg "HOST_UID=$uid" --build-arg "HOST_GID=$(id -g)" \
        -t "$tag" -t "$IMAGE_NAME:latest" "$CONTEXT" 2>&1)"; then
      printf '%s\n' "$log" >&2
      echo "ab: image build failed (see above)" >&2
      exit 1
    fi
    # Prune stale per-uid tags from prior builds (keep only this one + :latest). Best-effort:
    # a running container still references an old image's layers, so rmi just untags it then;
    # errors (image in use) are ignored. Stops agentbox:<uid>-<oldhash> images piling up.
    docker image ls --format '{{.Repository}}:{{.Tag}}' \
      | grep -F "${IMAGE_NAME}:${uid}-" | grep -vxF "$tag" \
      | xargs -r docker image rm >/dev/null 2>&1 || true
  fi
  printf '%s' "$tag"
}

is_running() { [ "$(docker inspect -f '{{.State.Running}}' "$cname" 2>/dev/null || true)" = "true" ]; }
exists() { [ -n "$(docker inspect -f '{{.Id}}' "$cname" 2>/dev/null || true)" ]; }

wait_ready() {
  for _ in $(seq 1 60); do
    docker exec "$cname" docker info >/dev/null 2>&1 && return 0
    sleep 0.5
  done
  echo "ab: WARNING — inner docker not ready yet; try 'ab logs'" >&2
  return 1
}

# Parse one line of the mounts list: print "<src>\t<dst>\t<mode>", or nothing for a comment,
# blank, or malformed line. The grammar is `src [dst] [ro|rw]`, mode defaulting to ro.
#
# Two tokens are ambiguous — `~/notes rw` is src+mode while `~/notes /data` is src+dst — so the
# LAST token is checked against ro/rw first and consumed as the mode when it matches; whatever
# is left is then src, or src+dst. Consequence (documented in the README): a destination
# literally named `ro`/`rw` can't be expressed, and neither can a path containing spaces —
# whitespace is the token separator, the same limitation the `files` list had.
#
# A leading ~ is left literal here and expanded by build_user_mounts (~ -> $HOME on the source
# side, /home/agentbox on the destination side), which keeps this environment-independent for
# tests. Extracted so tests/run.sh can exercise the parse directly (no Docker needed). Always
# returns 0 — the caller runs it in a command substitution under `set -e`, and distinguishes
# "nothing to do" from "malformed" itself (see build_user_mounts).
ab_parse_mounts_line() {
  local s="${1%%#*}"      # drop a trailing # comment
  s="$(printf '%s' "$s" | tr -s '[:space:]' ' ')"                 # collapse whitespace
  s="${s#"${s%%[![:space:]]*}"}"; s="${s%"${s##*[![:space:]]}"}"  # trim ends
  [ -n "$s" ] || return 0
  local a b c extra src dst mode
  read -r a b c extra <<<"$s" || true
  [ -z "$extra" ] || return 0            # 4+ tokens -> malformed
  if [ -n "$c" ]; then                   # src dst mode  (a third token can ONLY be a mode)
    case "$c" in ro | rw) ;; *) return 0 ;; esac
    src="$a"; dst="$b"; mode="$c"
  elif [ -n "$b" ]; then                 # src mode  |  src dst
    case "$b" in
      ro | rw) src="$a"; dst="$a"; mode="$b" ;;
      *) src="$a"; dst="$b"; mode=ro ;;
    esac
  else                                   # src
    case "$a" in ro | rw) return 0 ;; esac   # a bare mode with no path is malformed
    src="$a"; dst="$a"; mode=ro
  fi
  printf '%s\t%s\t%s\n' "$src" "$dst" "$mode"
}

# Which of ab's own mounts already claims <dst>, if any (printed as the offending spec). A user
# mount onto an occupied destination makes `docker run` fail outright with "Duplicate mount
# point", taking the whole container with it — so build_user_mounts drops that one line instead.
# Handles both spec forms in the array: `-v src:dst[:opts]` and `--mount type=bind,src=…,dst=…`.
# Because user mounts are appended to the same array as they are accepted, this also catches a
# second user line targeting a destination an earlier one already took.
ab_mount_dest_owner() {
  local want="$1" m d
  for m in "${mounts[@]}"; do
    case "$m" in
      -v | --mount) continue ;;
      type=bind,*) d="${m#*,dst=}"; d="${d%%,*}" ;;
      *) d="${m#*:}"; d="${d%%:*}" ;;
    esac
    [ "$d" = "$want" ] && { printf '%s' "$m"; return 0; }
  done
  return 0
}

# Append a `--mount` flag to the mounts array for each line of the resolved `mounts` list, so
# host files and directories appear inside the container without being copied — the container
# sees host-side changes live, and a directory (which the old `files` copy refused) just works.
#
# `--mount` rather than `-v` for these: `-v` CREATES a missing source as a root-owned directory
# on the host, which is exactly the silent mess a typo'd path should not cause, while `--mount`
# errors. Each line is still validated here first so a bad line is named and skipped rather than
# failing the whole `docker run`: the source must be an absolute path that exists, the
# destination must be absolute and unclaimed, and neither may contain a comma (the `--mount`
# option separator, which has no escape).
#
# Called just before `docker run` (not at load time) so the warnings appear when a container is
# actually created, not on every `ab status`. Bind mounts can only be established at create
# time, so edits to the list need `ab destroy && ab start`. No-op without the file.
build_user_mounts() {
  local list="$cfg_mounts"
  [ -n "$list" ] || return 0
  local line parsed rest src dst mode lead owner n=0 ok=0
  while IFS= read -r line || [ -n "$line" ]; do
    parsed="$(ab_parse_mounts_line "$line")" || true
    if [ -z "$parsed" ]; then
      # Blank and #-comment lines legitimately yield nothing — stay quiet for those. A line with
      # real content that did not parse is a likely typo: name it (same treatment the entrypoint
      # gives a malformed ports line).
      lead="${line#"${line%%[![:space:]]*}"}"
      case "$lead" in '' | '#'*) ;; *)
        echo "ab: mounts: ignoring malformed line: $line (expected 'src [dst] [ro|rw]')" >&2 ;;
      esac
      continue
    fi
    src="${parsed%%$'\t'*}"
    rest="${parsed#*$'\t'}"
    dst="${rest%%$'\t'*}"
    mode="${rest##*$'\t'}"
    src="${src/#\~/$HOME}"            # ~ -> host home
    dst="${dst/#\~//home/agentbox}"   # ~ -> container home
    n=$((n+1))
    case "$src$dst" in
      *,*) echo "ab: mounts: path contains a comma (unsupported by --mount), skipping: $src" >&2
           continue ;;
    esac
    case "$src" in /*) ;; *)
      echo "ab: mounts: source is not an absolute path, skipping: $src" >&2
      continue ;;
    esac
    case "$dst" in /*) ;; *)
      echo "ab: mounts: destination is not an absolute path, skipping: $dst" >&2
      continue ;;
    esac
    if [ ! -e "$src" ]; then
      echo "ab: mounts: source not found, skipping: $src" >&2
      continue
    fi
    owner="$(ab_mount_dest_owner "$dst")"
    if [ -n "$owner" ]; then
      echo "ab: mounts: $dst is already mounted ($owner), skipping: $src" >&2
      continue
    fi
    # readonly is the default; only an explicit `rw` line gets a writable bind. A rw mount lets
    # the agent write to the host path — a deliberate trust grant, so it is reported at start.
    if [ "$mode" = rw ]; then
      mounts+=(--mount "type=bind,src=$src,dst=$dst")
      echo "ab: mounts: $src -> $dst (rw — the container can write to this host path)" >&2
    else
      mounts+=(--mount "type=bind,src=$src,dst=$dst,readonly")
    fi
    ok=$((ok+1))
  done < "$list"
  if [ "$n" -gt 0 ]; then
    echo "ab: mounts: $ok/$n mount(s) from ${list/#"$HOME"/\~}" >&2
  fi
  return 0
}

# `files` (copy host files in) was replaced by `mounts` (bind them in). Nothing reads a `files`
# list any more; this only ensures a leftover one is reported rather than silently doing nothing
# — the failure mode otherwise is an SSH key that quietly never arrives. The line grammar is
# unchanged, so migrating is a rename.
warn_legacy_files() {
  [ -n "$cfg_files_legacy" ] || return 0
  local shown="${cfg_files_legacy/#"$HOME"/\~}"
  echo "ab: $shown is no longer used — \`files\` was replaced by \`mounts\`." >&2
  echo "ab:        the line format is the same (plus an optional trailing ro|rw), so:" >&2
  echo "ab:          mv $shown ${shown%/*}/mounts" >&2
  return 0
}

cmd_start() {
  require_sysbox
  # Create the bind-mount sources as the invoking host user BEFORE `docker run`: Docker
  # creates a missing bind-mount dir owned by root, which the non-root agentbox user then
  # can't write to (claude/codex auth & sessions would fail). Creating them here prevents it.
  mkdir -p "$HOME/.claude" "$HOME/.codex"
  local tag
  tag="$(build_image)"
  warn_legacy_files
  if is_running; then
    echo "ab: $cname is already running."
    echo "ab: to recreate it (new settings/mounts), run: ab destroy && ab start"
    return 0
  fi
  if exists; then
    # An existing container keeps the bind mounts it was created with — `mounts` edits only take
    # effect on a fresh `docker run`, hence the `ab destroy && ab start` in the README.
    echo "ab: starting $cname ..." >&2
    docker start "$cname" >/dev/null
  else
    echo "ab: creating + starting $cname ..." >&2
    build_user_mounts   # append --mount flags from the resolved `mounts` list (no-op without)
    docker run -d --name "$cname" "${run_args[@]}" "${mounts[@]}" "$tag" >/dev/null
  fi
  # Non-blocking: return as soon as the container is up. The entrypoint brings the inner
  # dockerd up in the background; `ab claude`/`ab exec` work right away (claude needs no
  # dockerd), and inner-docker callers find it ready shortly after.
}

# Show which of the four config files are in effect for this machine + project, and the search
# that produced them. With four tiers per file, "why is THAT setup.sh running?" is otherwise a
# manual walk of the tree — this answers it in one command, without starting a container.
cmd_config() {
  local root_note=""
  [ -d "$AB_CFG_ROOT" ] || root_note="   (absent — no per-host config on this machine)"
  echo "machine: $MACHINE"
  echo "project: $PROJECT_DIR"
  echo "root:    ${AB_CFG_ROOT/#"$HOME"/\~}$root_note"
  echo
  echo "in effect:"
  printf '  %-9s %s\n' "env"      "$(ab_config_show "$cfg_env")"
  printf '  %-9s %s\n' "mounts"   "$(ab_config_show "$cfg_mounts")"
  printf '  %-9s %s\n' "ports"    "$(ab_config_show "$cfg_ports")"
  printf '  %-9s %s\n' "setup.sh" "$(ab_config_show "$cfg_setup")"
  echo
  echo "search order (first match wins; each of env, mounts, ports, setup.sh separately):"
  ab_config_candidates "${AB_CFG_ROOT/#"$HOME"/\~}" "$MACHINE" "$PROJECT_DIR" '<name>' | sed 's/^/  /'
  # A leftover `files` is not config any more — surface it here too, not just at `ab start`.
  if [ -n "$cfg_files_legacy" ]; then
    echo
    warn_legacy_files
  fi
}

cmd_exec() {
  is_running || cmd_start
  # No command (or a bare `bash`) → an interactive shell. Interactive non-login bash
  # sources ~/.bashrc on startup, which is where claude()/codex() are defined.
  if [ "$#" -eq 0 ] || { [ "$#" -eq 1 ] && [ "$1" = bash ]; }; then
    # -i keeps stdin open (so a piped command reaches the shell); -t only when stdin IS a
    # terminal — forcing -t under a pipe makes docker fail "the input device is not a TTY"
    # (e.g. `echo x | ab exec bash`). Source ~/.bashrc via BASH_ENV too, so claude()/codex()
    # are defined even without a tty: an interactive shell sources it directly and ignores
    # BASH_ENV, while a non-interactive one sources BASH_ENV instead (one way or the other,
    # the wrappers are present). Mirrors the -t gating of the command path below.
    local shell_args=(docker exec --user agentbox -i -e BASH_ENV=/home/agentbox/.bashrc)
    [ -t 0 ] && shell_args+=(-t)
    exec "${shell_args[@]}" "$cname" bash
  fi
  # Run the command so ~/.bashrc is ALWAYS applied — that's where claude()/codex() live,
  # the functions that inject --dangerously-skip-permissions /
  # --dangerously-bypass-approvals-and-sandbox. Without them `ab exec claude` runs the raw
  # binary (no bypass → it prompts on every tool use → unusable headless). `bash -ic` can't
  # do this: an interactive shell with no TTY spews "cannot set terminal process group / no
  # job control" and makes `docker exec -t` fail with "the input device is not a TTY" under
  # any pipe/CI. So source ~/.bashrc from a NON-interactive `bash -c` via BASH_ENV instead:
  # the functions get defined cleanly in every case (TTY or not), with no startup noise.
  # (.bashrc has no "if not interactive, return" guard, so its defs are reached this way.)
  #
  # -i is unconditional (keeps stdin open so pipes reach the command: `echo x | ab exec cat`).
  # -t is added only when stdin IS a terminal — docker's "the input device is not a TTY"
  # failure is specifically about stdin (fd 0), so gating on [ -t 0 ] is exactly what avoids
  # the crash while still giving claude/codex a real TTY for their TUI when run from a
  # terminal. printf '%q' rebuilds the args as one safely-quoted string so the FIRST word
  # stays a literal token — function lookup resolves a literal `claude`/`codex` to the wrapper
  # (e.g. `ab claude --resume` → claude() → --dangerously-skip-permissions --resume), never
  # the bare binary.
  local exec_args=(docker exec --user agentbox -i -e BASH_ENV=/home/agentbox/.bashrc)
  [ -t 0 ] && exec_args+=(-t)
  exec "${exec_args[@]}" "$cname" bash -c "$(printf '%q ' "$@")"
}

main() {
  case "${1:-}" in
  start) cmd_start ;;
  stop) if exists; then docker stop "$cname" >/dev/null && echo "ab: stopped $cname (kept; 'ab destroy' to remove)"; else echo "ab: $cname does not exist"; fi ;;
  destroy)
    # Attempt BOTH removals independently and report every failure: a failed container rm
    # must not skip the volume rm (or vice versa). Exit non-zero if either failed so a
    # partial failure isn't masked (e.g. by `ab destroy && ab start`). Explicit ifs, not
    # `A && B || true` — that form trips shellcheck SC2015 ("C may run when A is true").
    if ! exists; then
      echo "ab: $cname does not exist"
    else
      rc=0
      if docker rm -f "$cname" >/dev/null 2>&1; then
        echo "ab: removed $cname"
      else
        echo "ab: failed to remove container $cname (see: docker rm -f $cname)" >&2
        rc=1
      fi
      if docker volume rm "$dvol" >/dev/null 2>&1; then
        echo "ab: removed inner-docker volume $dvol"
      else
        echo "ab: failed to remove inner-docker volume $dvol (it may still be in use)" >&2
        rc=1
      fi
      exit "$rc"
    fi
    ;;
  status) is_running && echo "running: $cname" || echo "not running: $cname" ;;
  config) cmd_config ;;
  logs) docker logs --tail 80 "$cname" 2>&1 | tail -80 ;;
  exec)
    shift
    cmd_exec "$@"
    ;;
  rebuild)
    require_sysbox
    tag="$(build_image force)"
    mkdir -p "$HOME/.claude" "$HOME/.codex"
    warn_legacy_files
    echo "ab: recreating $cname with $tag ..." >&2
    docker rm -f "$cname" >/dev/null 2>&1 || true
    build_user_mounts   # append --mount flags from the resolved `mounts` list (no-op without)
    docker run -d --name "$cname" "${run_args[@]}" "${mounts[@]}" "$tag" >/dev/null
    wait_ready
    ;;
  # Help = this header comment block, with the leading `# ` stripped, printed as-is
  # (stops at the first non-comment line, so code is never shown).
  "" | -h | --help) awk 'NR>1 && /^#/{sub(/^#?/,""); print; next} NR>1{exit}' "$0" ;;
  *) cmd_exec "$@" ;;
  esac
}

# Run only when executed directly, not when sourced — so tests/run.sh can source this file
# and call compute_names() (and friends) without triggering any docker command.
if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
  main "$@"
fi
