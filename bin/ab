#!/usr/bin/env bash
# shellcheck disable=SC2015,SC2034 # intentional short-circuit idioms and exported context fields
#
# ab — Claude Code / Codex in a long-lived, **Sysbox-confined** agentbox container.
#
# agentbox is launched with `docker run --runtime=sysbox-runc`: Sysbox isolates the
# container so the inner Docker daemon (rootful, in-container) cannot reach the host —
# nested Docker with no --privileged and no host docker socket.
#
#   ab start [--no-git] [--grant-gh] [--grant-all-of-dot-ssh] [--apply]
#                            create + start the container for the current project
#   ab stop                  stop it (kept on disk; /tmp build state preserved)
#   ab destroy               stop + remove it (destroyed; /tmp build state lost)
#   ab status                show whether the container is running
#   ab config                show which per-machine/per-project config files are in effect
#   ab config init [--machine] [--project] [file...]
#                            create a config tier's directory (+ starter templates for the
#                            named files, e.g. env mounts ports setup.sh networks Dockerfile)
#   ab logs                  tail the container / inner-dockerd logs
#   ab claude [args...]      docker exec claude as the agentbox user (auto-starts if not started)
#   ab codex  [args...]      docker exec codex
#   ab bash                  docker exec bash
#   ab exec <cmd...>         docker exec an arbitrary command (as agentbox)
#   ab build   [--no-git] [--no-cache] [--grant-gh] [--grant-all-of-dot-ssh]
#   ab rebuild [--no-git] [--no-cache] [--grant-gh] [--grant-all-of-dot-ssh]  (synonym for build)
#                            build or rebuild the image and recreate the running container (--no-cache
#                            busts Docker's build cache too — needed to actually pick up a newer
#                            claude/codex release, since CLAUDE_CHANNEL=stable/CODEX_RELEASE=latest
#                            otherwise just re-hit the cached install layer from the last build)
#   ab --version             print the agentbox version
#
# Each project path gets its own container (and its own inner-docker data root), so
# per-container state — notably CARGO_TARGET_DIR=/tmp/target — persists across ab
# invocations until `ab destroy`.
#
# Host prerequisite: Sysbox must be installed + registered as a docker runtime
# (see README.md). `ab start` checks for it and bails with guidance if missing.
#
set -euo pipefail

policy_fail() {
  echo "agentbox: policy: $*" >&2
  return 1
}

# Host credential mounts are per-invocation grants, deliberately disabled by default.
grant_gh=0
grant_all_of_dot_ssh=0
grant_labels=()
policy_labels=()
policy_git_enabled=""
policy_grant_gh=""
policy_grant_all_of_dot_ssh=""
policy_updates_check=""
policy_git_source="default"
policy_grant_gh_source="default"
policy_grant_all_of_dot_ssh_source="default"
policy_updates_source="default"
policy_recorded_status="none"
policy_recorded_git_enabled=""
policy_recorded_grant_gh=""
policy_recorded_grant_all_of_dot_ssh=""
policy_recorded_digest=""
policy_recorded_detail=""
policy_recorded_classification="absent"
policy_recorded_lifecycle_state="absent"
policy_recorded_mount_consistency="unknown"
policy_mount_consistency="unknown"
# Task 5's resolved-policy record is deliberately data-only. Later tasks may consume it, but
# constructing this record never decides whether to mutate a container or executes a command.
policy_tier_names=(global machine project machine_project)
declare -A policy_tier_path=() policy_tier_state=()
declare -A policy_tier_git_enabled=() policy_tier_grant_gh=()
declare -A policy_tier_grant_all_of_dot_ssh=() policy_tier_updates_check=()
declare -A policy_resolved_effective=() policy_resolved_source=()
declare -A policy_resolved_labels=()
# A recorded-state decision must be derived from one Docker inspect result. These maps are a
# short-lived cache used only while policy_inspect_recorded classifies that result.
declare -A policy_container_snapshot_labels=() policy_container_snapshot_mount_sources=()
declare -A policy_container_snapshot_mount_modes=() policy_container_snapshot_mount_names=()
declare -A policy_container_snapshot_mount_types=()
policy_container_snapshot_lifecycle=absent
policy_container_snapshot_ready=0
policy_container_snapshot_retain=0
policy_needs_recreate=0
policy_cli_git_enabled=""
policy_cli_grant_gh=""
policy_cli_grant_all_of_dot_ssh=""
policy_apply=0
policy_command_args=()
policy_explicit_exec_command=0
policy_input_env_captured=0
policy_operation_requested=0
policy_snapshot_retry_count=0
policy_operation_mode=""
policy_operation_retry=0
policy_retry_reconcile=0

# Task 7 durable lifecycle handoff. The record is deliberately host-side and privacy-preserving:
# it contains identifiers, outcomes, and digests, never policy-file contents or credential paths.
operation_record_path=""
operation_record_dir=""
operation_id=""
operation_phase=""
operation_status=""
operation_started_at=""
